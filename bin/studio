#!/usr/bin/env bash
# Dev Studio: one click opens a team of coding-agent sessions in Herdr, with a
# board that shows JEV routing every message between them.
#   studio up [project] [--codex|--claude] [--router jev|clef|rules]
#   studio board          the board (runs inside the studio's first tab)
#   studio router         the message router (runs inside the studio's team tab)
#   studio send FROM TO "text"   send a peer message through the router
#   studio ask "text"     dry run: what would the router decide?
#   studio doctor         check everything is installed
#   studio stop           stop the studio's Herdr session and every agent in it
set -u

SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in /*) SELF=$link ;; *) SELF=$(dirname "$SELF")/$link ;; esac
done
STUDIO_HOME=$(cd "$(dirname "$SELF")/.." && pwd)
export STUDIO_HOME
# shellcheck source=../lib/common.sh
. "$STUDIO_HOME/lib/common.sh"

usage() {
  cat <<EOF
${C_PINK}${C_BOLD}Dev Studio${C_RESET}  your AI dev team, one click away

  studio up [--codex|--claude] [--router jev|clef|rules] [--no-attach]
                          open (or reopen) the team in the studio's home (~/DevStudio)
  studio up <project>     the team on a specific project folder; --pick shows a chooser
  studio up ... [--architect-kind claude|codex] [--main-kind claude|codex]
                [--worker-kind claude|codex | --workers-mixed]
                          each role's CLI; --workers-mixed gives codex, claude, codex… workers
  studio up ... [--reviewer codex|claude|none]
                          a read-only reviewer that checks each worker's "done <commit>"
                          (default from REVIEWER in studio.conf, which starts none)
  studio review <commit>  ask the reviewer for a verdict on a commit (the router does this itself)
  studio status [project] who is on the team and which CLI each one runs
  studio board            the live board (what the first tab shows)
  studio send FROM TO "note"   send a peer message through the router (TO = @name or auto)
  studio ask "note"       dry run: show what the router would decide
  studio web              the board as a web page for your phone or laptop (kept up by launchd)
  studio doctor           check that everything is installed
  studio stop             stop the studio and every agent in it
EOF
}

# --- Herdr helpers -----------------------------------------------------------

# The studio's Herdr server runs under launchd with KeepAlive: a server started
# from the Dock app's launcher dies when that launcher exits a second later
# (macOS reaps the app's children), and this way it also restarts after a crash.
LAUNCHD_LABEL=dev.studio.herdr
launchd_plist() { printf '%s/Library/LaunchAgents/%s.plist' "$HOME" "$LAUNCHD_LABEL"; }

start_server_launchd() {
  local plist herdr_bin
  plist=$(launchd_plist); herdr_bin=$(command -v "$HERDR")
  mkdir -p "$(dirname "$plist")" "$STUDIO_DATA/logs"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LAUNCHD_LABEL</string>
  <key>ProgramArguments</key><array>
    <string>$herdr_bin</string><string>--session</string><string>$STUDIO_SESSION</string><string>server</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>HOME</key><string>$HOME</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$STUDIO_DATA/logs/herdr-server.log</string>
  <key>StandardErrorPath</key><string>$STUDIO_DATA/logs/herdr-server.log</string>
</dict></plist>
PLIST
  launchctl bootout "gui/$(id -u)/$LAUNCHD_LABEL" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || launchctl kickstart -k "gui/$(id -u)/$LAUNCHD_LABEL" 2>/dev/null
}

ensure_server() {
  hd workspace list >/dev/null 2>&1 && return 0
  say "Waking up Herdr…"
  mkdir -p "$STUDIO_DATA/logs"
  if [ "${STUDIO_SUPERVISOR:-launchd}" = launchd ] && [ -n "${STUDIO_SESSION:-}" ] && is_macos; then
    start_server_launchd
  else
    # nohup needs a real binary, so spell the session flag out instead of using hd.
    nohup "$HERDR" ${STUDIO_SESSION:+--session "$STUDIO_SESSION"} server >>"$STUDIO_DATA/logs/herdr-server.log" 2>&1 &
  fi
  local i=0
  while [ $i -lt 40 ]; do
    hd workspace list >/dev/null 2>&1 && return 0
    sleep 0.25; i=$((i + 1))
  done
  die "Herdr didn't start. Log: $STUDIO_DATA/logs/herdr-server.log"
}

# Print the id of the workspace with this label, if it exists.
find_workspace() {
  hd workspace list 2>/dev/null | jq -r --arg l "$1" '
    [.. | objects | select(.label? == $l or .name? == $l) | (.workspace_id // .id // empty)] | first // empty' 2>/dev/null
}

new_workspace() { # label cwd [env] -> "workspace-id root-pane-id"
  hd workspace create --cwd "$2" --label "$1" ${3:+--env "$3"} --no-focus | jq -r '"\(.result.workspace.workspace_id) \(.result.root_pane.pane_id)"'
}

new_tab() { # workspace label cwd [env] -> root pane id
  hd tab create --workspace "$1" --label "$2" --cwd "$3" ${4:+--env "$4"} --no-focus | jq -r '.result.root_pane.pane_id'
}

split() { # pane direction new-pane-share cwd [env] -> new pane id
  # Herdr's --ratio is the share the ORIGINAL pane keeps (checked on herdr 0.9.3:
  # `split down 0.25` left the original 10 of 40 rows), so convert from the share
  # the layouts give the new pane.
  local keep
  keep=$(awk -v r="$3" 'BEGIN { printf "%.2f", 1 - r }')
  hd pane split "$1" --direction "$2" --ratio "$keep" --cwd "$4" ${5:+--env "$5"} --no-focus | jq -r '.result.pane.pane_id'
}

# Each agent's pane gets its own secret (STUDIO_SEAL, passed as herdr --env) so `studio send` can sign
# messages; only the router pane gets the whole map (STUDIO_TOKENS). Neither is
# written to disk, so an agent cannot read another agent's token from a file.
new_token() { od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }
TOKENS_JSON='{}'
issue_token() { # name -> sets TOKEN and remembers it for the router (no subshell: the map must survive)
  TOKEN=$(new_token)
  TOKENS_JSON=$(printf '%s' "$TOKENS_JSON" | jq -c --arg n "$1" --arg t "$TOKEN" '. + {($n): $t}')
}

# --- Agents --------------------------------------------------------------------

# Write this agent's role brief with the real names filled in.
role_file() { # role agent-name -> path
  local out="$STUDIO_DATA/run/$2.md"
  mkdir -p "$STUDIO_DATA/run"
  sed -e "s/<project>/$PROJECT_SLUG/g" -e "s/<me>/$2/g" -e "s#<studio-dir>#$STUDIO_DIR#g" "$STUDIO_HOME/roles/$1.md" > "$out"
  [ -f "$STUDIO_HOME/LESSONS.md" ] && { printf '\n\n'; cat "$STUDIO_HOME/LESSONS.md"; } >> "$out"
  printf '%s' "$out"
}

# Tell Herdr the agent's name once it detects the session. Herdr only knows an
# agent by its pane until it is named (herdr 0.9.3), so retry until detection.
name_agent() { # pane name
  local i=0
  while [ $i -lt 60 ]; do
    hd agent rename "$1" "$2" >/dev/null 2>&1 && return 0
    sleep 0.5; i=$((i + 1))
  done
  warn "Herdr hasn't spotted $2 yet, so its pane shows as $1 for now."
}

# The git worktree a codex worker works in: the same folder and branch claude --worktree
# makes (.claude/worktrees/<name>, branch worktree-<name>). Reused when both exist;
# fails (status 1) when git can't make it, e.g. a project with no commit yet.
ensure_worktree() { # project-dir name
  local dir="$1/.claude/worktrees/$2" branch="worktree-$2"
  if git -C "$1" rev-parse --verify -q "$branch" >/dev/null 2>&1; then
    [ -d "$dir" ] || git -C "$1" worktree add -q "$dir" "$branch" >/dev/null 2>&1
  else
    git -C "$1" worktree add -q -b "$branch" ".claude/worktrees/$2" >/dev/null 2>&1
  fi
  [ -d "$dir" ] && git -C "$1" rev-parse --verify -q "$branch" >/dev/null 2>&1
}

# " --add-dir <real path>" for a path whose real location (pwd -P) lies strictly inside
# <root>/, or nothing. The root itself is never granted, and neither is anything outside it.
grant_under() { # root path
  local p
  [ -n "$2" ] || return 0   # cd "" would succeed and name the current folder
  p=$(cd "$2" 2>/dev/null && pwd -P) || return 0
  case $p in "$1"/*) printf ' --add-dir %s' "$(printf %q "$p")" ;; esac
}

# The owner's extra folders for codex workers: each valid line of <project>/.studio/codex-writable
# becomes " --add-dir <real path>". Lines are relative to the project; # starts a comment; blank
# lines are skipped. A line is valid only if it resolves (pwd -P) to a folder inside the project and
# not inside its .git. Anything else is skipped with a warning that names the line.
# macOS folders are case-insensitive, so ".GIT" is the folder ".git". Every name check below runs on a
# lower-cased copy of the path.
_lower() {
  # shellcheck disable=SC2018,SC2019
  printf '%s' "$1" | tr 'A-Z' 'a-z'
}

# Sets BELOW to the part of real below project, both lower-cased. Returns 1 if real is not inside project.
_below() { # real project
  local r p
  r=$(_lower "$1"); p=$(_lower "$2")
  case $r in
    "$p") BELOW=''; return 0 ;;
    "$p"/*) BELOW=${r#"$p"/}; return 0 ;;
  esac
  return 1
}

# Paths (relative to the project, lower-cased) that codex is never granted: the project root, anything
# with a .git component at any depth, .studio itself, .studio/mail and below, and .claude and .codex and
# below. Other .studio folders (such as .studio/localq) are fine.
_writable_forbidden() { # relative-lower-path
  case $1 in
    ''|.git|.git/*|*/.git|*/.git/*|.studio|.studio/mail|.studio/mail/*|.claude|.claude/*|.codex|.codex/*) return 0 ;;
  esac
  return 1
}

# Check one line of codex-writable. On success sets WRITABLE_REAL to the folder's real path.
# Lexical checks first; then the deepest existing parent is resolved with pwd -P and must be inside the
# project (so a symlinked parent pointing outside stops here, before anything is created); then the
# folder is created; then its real path is checked again.
_writable_one() { # project-dir rel where
  local project=$1 rel=$2 where=$3 lrel cur base real
  case $rel in
    /*) warn "$where ($rel) is an absolute path; use a path inside the project."; return 1 ;;
  esac
  case "/$rel/" in */../*) warn "$where ($rel) has a '..' part; use a path inside the project."; return 1 ;; esac
  lrel=$(_lower "$rel")
  case "/$lrel/" in */.git/*) warn "$where ($rel) is inside .git, which is never granted."; return 1 ;; esac
  case $lrel in
    .|./) warn "$where ($rel) is the project root itself, which is never granted."; return 1 ;;
    .studio|.studio/mail|.studio/mail/*) warn "$where ($rel) is .studio or .studio/mail, which is never granted."; return 1 ;;
  esac
  if _writable_forbidden "$lrel"; then
    warn "$where ($rel) is never granted: .claude and .codex hold the worktrees and settings."; return 1
  fi
  cur="$project/$rel"
  while [ ! -e "$cur" ] && [ "$cur" != "$project" ]; do cur=$(dirname "$cur"); done
  base=$(cd "$cur" 2>/dev/null && pwd -P) || { warn "$where ($rel) cannot be checked."; return 1; }
  _below "$base" "$project" || { warn "$where ($rel) resolves outside the project."; return 1; }
  case $BELOW in
    .git|.git/*|*/.git|*/.git/*|.studio/mail|.studio/mail/*|.claude|.claude/*|.codex|.codex/*)
      warn "$where ($rel) resolves into a folder codex is never granted."; return 1 ;;
  esac
  [ -e "$project/$rel" ] || mkdir -p "$project/$rel" 2>/dev/null || { warn "$where ($rel) could not be created."; return 1; }
  real=$(cd "$project/$rel" 2>/dev/null && pwd -P) || { warn "$where ($rel) is not a folder."; return 1; }
  _below "$real" "$project" || { warn "$where ($rel) resolves outside the project."; return 1; }
  if _writable_forbidden "$BELOW"; then
    warn "$where ($rel) resolves into a folder codex is never granted."; return 1
  fi
  WRITABLE_REAL=$real
  return 0
}

# The owner's extra folders for codex workers: each valid line of <project>/.studio/codex-writable
# becomes " --add-dir <real path>". Lines are relative to the project; # starts a comment; blank lines
# are skipped; a missing folder is created. A refused line is skipped with a warning that names it,
# and codex still starts.
codex_writable_grants() { # real-project studio-dir name
  local file="$2/codex-writable" line rel out='' n=0
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    rel=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's#/*$##')
    case $rel in ''|'#'*) continue ;; esac
    _writable_one "$1" "$rel" "$3: codex-writable line $n" || continue
    out="$out --add-dir $(printf %q "$WRITABLE_REAL")"
  done < "$file"
  printf '%s' "$out"
}

# The reviewer's command: it reads the project and writes nothing. Codex runs in the project
# folder with a read-only sandbox, and gets no outbox and no worktree; claude gets plan mode.
# It never sends messages: the router relays its verdict. kind model name brief -> command
reviewer_cmd() {
  if [ "$1" = codex ]; then
    printf 'cd %s && codex -m %s --sandbox read-only %s' "$(printf %q "$PROJECT_DIR")" "$2" \
      "$(printf %q "You are $3. Read $4 now and follow it as your role for this whole session. Then say which role you have and wait.")"
  else
    printf 'claude --name %s --model %s --permission-mode plan --settings %s --append-system-prompt-file %s' \
      "$3" "$2" "$(printf %q "$STUDIO_HOME/settings/peer.json")" "$(printf %q "$4")"
  fi
}

# start_agent pane label role name model kind [worktree]
start_agent() {
  local pane=$1 label=$2 role=$3 name=$4 model=$5 kind=$6 worktree=${7:-} brief cmd dir sandbox='' adds='' real_project='' outbox='' common='' wd=''
  brief=$(role_file "$role" "$name")
  if [ "$role" = reviewer ]; then
    cmd=$(reviewer_cmd "$kind" "$model" "$name" "$brief")
  elif [ "$kind" = codex ]; then
    # Codex has no system-prompt flag: the role brief is its first prompt. A codex worker
    # gets the same git worktree claude --worktree makes, and codex starts inside it.
    dir=$PROJECT_DIR
    if [ -n "$worktree" ]; then
      if ensure_worktree "$PROJECT_DIR" "$worktree"; then
        dir=$PROJECT_DIR/.claude/worktrees/$worktree
      else
        warn "Couldn't create the worktree for $name; it starts in the project folder instead."
      fi
    fi
    # CODEX_SANDBOX (lib/common.sh) picks codex's sandbox; blank keeps codex's own default.
    [ -n "${CODEX_SANDBOX:-}" ] && sandbox="--sandbox $(printf %q "$CODEX_SANDBOX") "
    # Codex's sandbox is opened for the outbox, so `studio send` works from inside codex.
    # Sandboxes check real paths, so the grant is resolved with pwd -P, and it is given only
    # when the resolved outbox is exactly <resolved project>/.studio/mail/outbox. An outbox
    # (or .studio) that is a symlink to somewhere else gets no grant at all.
    real_project=$(cd "$PROJECT_DIR" 2>/dev/null && pwd -P)
    outbox=$(cd "$STUDIO_DIR/mail/outbox" 2>/dev/null && pwd -P)
    if [ -n "$real_project" ] && [ "$outbox" = "$real_project/.studio/mail/outbox" ]; then
      adds="--add-dir $(printf %q "$outbox")"
    else
      adds=''
      warn "Not granting $name the outbox: $STUDIO_DIR/mail/outbox does not resolve inside the project."
    fi
    # A codex worker commits in its own worktree, so the sandbox also gets the git pieces a
    # commit writes: <common>/objects, <common>/refs, <common>/logs and the worktree's own git
    # directory (<common>/worktrees/<name>). Never the .git root, hooks, config, info or
    # packed-refs. Every path is resolved with pwd -P and kept only if it is inside
    # <project>/.git. Verified with the real codex 0.164 sandbox: add, commit, reset and branch
    # create work with this grant. Branch and tag delete still prompt (they need
    # .git/packed-refs.lock). commit and reset print a harmless packed-refs.lock warning.
    if [ -n "$worktree" ] && [ -n "$real_project" ]; then
      common=$(cd "$PROJECT_DIR" 2>/dev/null && git rev-parse --git-common-dir 2>/dev/null) || common=''
      case $common in ''|/*) ;; *) common="$PROJECT_DIR/$common" ;; esac
      [ -n "$common" ] && common=$(cd "$common" 2>/dev/null && pwd -P) || common=''
      if [ -n "$common" ] && [ "$common" = "$real_project/.git" ]; then
        mkdir -p "$common/objects" "$common/refs" "$common/logs" 2>/dev/null
        adds="$adds$(grant_under "$common" "$common/objects")"
        adds="$adds$(grant_under "$common" "$common/refs")"
        adds="$adds$(grant_under "$common" "$common/logs")"
        wd=$(cd "$dir" 2>/dev/null && git rev-parse --git-dir 2>/dev/null) || wd=''
        case $wd in ''|/*) ;; *) wd="$dir/$wd" ;; esac
        adds="$adds$(grant_under "$common" "$wd")"
      fi
      adds="$adds$(codex_writable_grants "$real_project" "$STUDIO_DIR" "$name")"
    fi
    cmd="cd $(printf %q "$dir") && codex -m $model $sandbox$adds $(printf %q "You are $name. Read $brief now and follow it as your role for this whole session. Then say which role you have and wait.")"
  else
    cmd="claude --name $name --model $model"
    [ -n "$worktree" ] && cmd="$cmd --worktree $worktree"
    cmd="$cmd --settings $(printf %q "$STUDIO_HOME/settings/peer.json")"
    cmd="$cmd --append-system-prompt-file $(printf %q "$brief")"
  fi
  hd pane rename "$pane" "$label" >/dev/null 2>&1 || true
  hd pane run "$pane" "$cmd" >/dev/null
  name_agent "$pane" "$name"
}

start_pane_cmd() { # pane label command
  hd pane rename "$1" "$2" >/dev/null 2>&1 || true
  hd pane run "$1" "$3" >/dev/null
}

# --- Kinds: which CLI each role runs ------------------------------------------------
# A role's kind is claude or codex. `studio up` sets KIND_ARCH, KIND_MAIN and
# WORKER_KINDS (one word per worker); team.json keeps them, and load_team reads them
# back. A team.json from before mixed teams has no "kinds", so every role uses "kind".

# The kind of worker N (1-based).
worker_kind() {
  local i=1 k
  for k in $WORKER_KINDS; do
    [ "$i" = "$1" ] && { printf '%s' "$k"; return 0; }
    i=$((i + 1))
  done
  printf '%s' "$KIND_WORKER"
}

# The model a role gets for a kind: claude or codex model settings from the config.
model_for() { # kind role -> model
  if [ "$1" = codex ]; then
    case $2 in architect) printf '%s' "$CODEX_ARCHITECT_MODEL" ;; main) printf '%s' "$CODEX_MAIN_MODEL" ;; *) printf '%s' "$CODEX_WORKER_MODEL" ;; esac
  else
    case $2 in architect) printf '%s' "$ARCHITECT_MODEL" ;; main) printf '%s' "$MAIN_MODEL" ;; *) printf '%s' "$WORKER_MODEL" ;; esac
  fi
}

# Does any role of this team run this kind? (trust and install checks need it)
team_uses() {
  local k
  for k in $KIND_ARCH $KIND_MAIN $KIND_WORKER $WORKER_KINDS; do [ "$k" = "$1" ] && return 0; done
  [ "${REVIEWER:-none}" = "$1" ] && return 0   # a claude reviewer still needs the trust step
  return 1
}

# "claude", "codex", or "mixed" when the roles run both: names the workspace.
team_suffix() {
  local kinds
  if [ -n "$WORKER_KINDS" ]; then
    # shellcheck disable=SC2086
    kinds=$(printf '%s\n' "$KIND_ARCH" "$KIND_MAIN" $WORKER_KINDS | sort -u)
  else
    kinds=$(printf '%s\n' "$KIND_ARCH" "$KIND_MAIN" "$KIND_WORKER" | sort -u)
  fi
  if [ "$(printf '%s\n' "$kinds" | wc -l | tr -d ' ')" = 1 ]; then printf '%s' "$kinds"; else printf 'mixed'; fi
}

# "architect=claude,main=claude,worker-1=codex,…" for the board and the web view.
kinds_arg() {
  local s="architect=$KIND_ARCH,main=$KIND_MAIN" n=1
  while [ $n -le "$WORKERS" ]; do s="$s,worker-$n=$(worker_kind "$n")"; n=$((n + 1)); done
  printf '%s' "$s"
}

# "worker-1 codex, worker-2 claude" for the status line.
workers_summary() {
  local s='' n=1
  while [ $n -le "$WORKERS" ]; do s="$s${s:+, }worker-$n $(worker_kind "$n")"; n=$((n + 1)); done
  printf '%s' "$s"
}

# Set the models for the three roles from their kinds (the role's kind is an argument).
pick_models() { # architect-kind main-kind worker-kind
  KIND_ARCH=$1; KIND_MAIN=$2; KIND_WORKER=$3
  ARCH_M=$(model_for "$1" architect); MAIN_M=$(model_for "$2" main); WORKER_M=$(model_for "$3" worker)
}

# The router and board need to know who is on the team and what each one does.
write_peers() {
  local n=1 json k
  json="{\"$PROJECT_SLUG-architect\":{\"role\":\"architect: plans, audits, signs off before merge\",\"model\":\"$ARCH_M\",\"kind\":\"$KIND_ARCH\"},"
  json="$json\"$PROJECT_SLUG-main\":{\"role\":\"main session: builds the feature, syncs schemas, patches dependents\",\"model\":\"$MAIN_M\",\"kind\":\"$KIND_MAIN\"}"
  while [ $n -le "$WORKERS" ]; do
    k=$(worker_kind "$n")
    json="$json,\"$PROJECT_SLUG-worker-$n\":{\"role\":\"worker $n: small delegated tasks in its own worktree\",\"model\":\"$(model_for "$k" worker)\",\"kind\":\"$k\"}"
    n=$((n + 1))
  done
  if [ "${REVIEWER:-none}" != none ]; then
    # The role says it takes no messages, so the router sends it only the review requests.
    json="$json,\"$PROJECT_SLUG-reviewer\":{\"role\":\"reviewer: reads each worker's done commit and reports REVIEW PASS, CHANGES or BLOCK; takes no other messages\",\"model\":\"$(model_for "$REVIEWER" reviewer)\",\"kind\":\"$REVIEWER\"}"
  fi
  printf '%s}\n' "$json" | jq . > "$STUDIO_DIR/peers.json"
  jq -n --arg k "$AGENT_KIND" --arg r "$ROUTER" --arg a "$ARCH_M" --arg m "$MAIN_M" --arg w "$WORKER_M" --argjson n "$WORKERS" \
    --arg ka "$KIND_ARCH" --arg km "$KIND_MAIN" --argjson kinds "$(team_kinds_json)" --arg rv "$REVIEWER" \
    '{kind: $k, router: $r, arch_model: $a, main_model: $m, worker_model: $w, workers: $n, reviewer: $rv,
      kinds: ({architect: $ka, main: $km} + $kinds)}' > "$STUDIO_DIR/team.json"
}

# {"worker-1": "codex", …} for team.json.
team_kinds_json() {
  local s='' n=1
  while [ $n -le "$WORKERS" ]; do s="$s${s:+,}\"worker-$n\":\"$(worker_kind "$n")\""; n=$((n + 1)); done
  printf '{%s}' "$s"
}

# A project's team (kind, kinds, router, models) is what was launched for it, not
# whatever the config says now: another project may have been opened since.
load_team() {
  local f="$STUDIO_DIR/team.json" n=1 k
  if [ ! -f "$f" ]; then
    pick_models "$AGENT_KIND" "$AGENT_KIND" "$AGENT_KIND"
    WORKER_KINDS=''
    REVIEWER=none
    set_label
    return 0
  fi
  AGENT_KIND=$(jq -r .kind "$f")
  REVIEWER=$(jq -r '.reviewer // "none"' "$f")   # teams from before reviewers have none
  ROUTER=$(jq -r .router "$f")
  ARCH_M=$(jq -r .arch_model "$f")
  MAIN_M=$(jq -r .main_model "$f")
  WORKER_M=$(jq -r .worker_model "$f")
  WORKERS=$(jq -r '.workers // 0' "$f")
  KIND_ARCH=$(jq -r '.kinds.architect // .kind' "$f")
  KIND_MAIN=$(jq -r '.kinds.main // .kind' "$f")
  KIND_WORKER=$AGENT_KIND
  WORKER_KINDS=''
  while [ $n -le "$WORKERS" ]; do
    k=$(jq -r --arg w "worker-$n" '.kinds[$w] // .kind' "$f")
    WORKER_KINDS="$WORKER_KINDS $k"
    n=$((n + 1))
  done
  WORKER_KINDS=${WORKER_KINDS# }
  set_label
}

# --- Layout ------------------------------------------------------------------------

# Cap workers so the whole team fits in the memory that's free right now.
fit_workers() {
  local avail per=${MB_PER_AGENT:-600} others=2 max
  [ "${REVIEWER:-none}" = none ] || others=3   # the reviewer is one more agent in memory
  avail=$(mem_available_mb)
  case $avail in ''|*[!0-9]*) return 0 ;; esac
  max=$(( (avail - ${MEM_RESERVE_MB:-1536}) / per - others ))
  [ "$max" -lt 1 ] && max=1
  if [ "$WORKERS" -gt "$max" ]; then
    warn "Only ${avail}MB of memory free, so starting $max worker(s) instead of $WORKERS."
    WORKERS=$max
  fi
}

# Tab 1 "team": the terminals (what opens).   Tab 2 "board": the text board, for a tile
# without a browser. The real board is the web page the Dock opens beside the team.
#  ┌──────────────┬──────────────┐
#  │              │ main         │
#  │ architect    ├──────────────┤
#  │              │ worker-1     │
#  ├──────────────┼──────────────┤
#  │ router       │ worker-2 …   │
#  └──────────────┴──────────────┘
# With --reviewer, the reviewer sits under the last worker (or under main with no workers).
layout() {
  local ws team col router pane next n=1 left TOKEN board wk wm
  issue_token "$PROJECT_SLUG-architect"
  # The workspace's --env reaches its root pane only (probed on herdr 0.9.5: a later
  # tab and a split both saw it unset), so this token stays in the architect's pane.
  # shellcheck disable=SC2046
  set -- $(new_workspace "$WS_LABEL" "$PROJECT_DIR" "STUDIO_SEAL=$TOKEN")
  ws=$1; team=$2
  hd tab rename "$ws:t1" team >/dev/null 2>&1 || true
  board=$(new_tab "$ws" board "$PROJECT_DIR")
  start_pane_cmd "$board" "board" "$(printf %q "$STUDIO_HOME/bin/studio") board $(printf %q "$PROJECT_DIR")"
  issue_token "$PROJECT_SLUG-main"
  col=$(split "$team" right 0.45 "$PROJECT_DIR" "STUDIO_SEAL=$TOKEN")
  write_peers
  start_agent "$team" "architect · $ARCH_M · $KIND_ARCH" architect "$PROJECT_SLUG-architect" "$ARCH_M" "$KIND_ARCH"
  start_agent "$col" "main · $MAIN_M · $KIND_MAIN" main "$PROJECT_SLUG-main" "$MAIN_M" "$KIND_MAIN"
  pane=$col
  while [ $n -le "$WORKERS" ]; do
    left=$((WORKERS - n + 1))
    issue_token "$PROJECT_SLUG-worker-$n"
    next=$(split "$pane" down "$(awk -v l="$left" 'BEGIN{printf "%.2f", l/(l+1)}')" "$PROJECT_DIR" "STUDIO_SEAL=$TOKEN")
    wk=$(worker_kind "$n"); wm=$(model_for "$wk" worker)
    start_agent "$next" "worker-$n · $wm · $wk" worker "$PROJECT_SLUG-worker-$n" "$wm" "$wk" "worker-$n"
    pane=$next
    n=$((n + 1))
  done
  if [ "${REVIEWER:-none}" != none ]; then
    # The reviewer gets a token the router holds, but no seal in its pane: only the router's
    # review child is given it, so the reviewer cannot sign a studio send.
    issue_token "$PROJECT_SLUG-reviewer"
    next=$(split "$pane" down 0.5 "$PROJECT_DIR")
    start_agent "$next" "reviewer · $(model_for "$REVIEWER" reviewer) · $REVIEWER" reviewer "$PROJECT_SLUG-reviewer" "$(model_for "$REVIEWER" reviewer)" "$REVIEWER"
  fi
  # The router pane is split last so its environment can carry every token.
  router=$(split "$team" down 0.25 "$PROJECT_DIR" "STUDIO_TOKENS=$TOKENS_JSON")
  start_pane_cmd "$router" "router · $ROUTER" "$(printf %q "$STUDIO_HOME/bin/studio") router $(printf %q "$PROJECT_DIR")"
  hd tab focus "$ws:t1" >/dev/null 2>&1 || true
  WS_ID=$ws
}

# --- Picking a project -------------------------------------------------------------

list_projects() {
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -mindepth 2 -maxdepth 2 -name .git 2>/dev/null \
    | sed 's#/\.git$##' | xargs -I{} basename {} | sort -f
}

pick_project() {
  local choice='' projects default
  projects=$(list_projects)
  default=${LAST_PROJECT:+$(basename "$LAST_PROJECT")}
  if [ "${STUDIO_GUI:-0}" = 1 ] && is_macos; then
    [ -n "$projects" ] || die "No git projects found in $PROJECTS_DIR"
    choice=$(osascript "$STUDIO_HOME/macos/pick-project.applescript" "$projects" "$default" 2>/dev/null)
    [ -n "$choice" ] || exit 0   # cancelled
  elif [ ! -t 0 ] || [ -z "$projects" ]; then
    choice=$default
  else
    printf '%s\n' "${C_PINK}${C_BOLD}Which project?${C_RESET}"
    printf '%s\n' "$projects" | awk '{printf "  %2d) %s\n", NR, $0}'
    printf 'Number or name%s: ' "${default:+ [$default]}"
    read -r choice
    [ -z "$choice" ] && choice=$default
    case $choice in
      ''|*[!0-9]*) ;;
      *) choice=$(printf '%s\n' "$projects" | sed -n "${choice}p") ;;
    esac
  fi
  [ -n "$choice" ] || die "No project chosen."
  printf '%s' "$choice"
}

resolve_project() {
  case $1 in
    /*|./*|../*|~*) (cd "$1" 2>/dev/null && pwd) ;;
    *) [ -d "$PROJECTS_DIR/$1" ] && (cd "$PROJECTS_DIR/$1" && pwd) ;;
  esac
}

# The project's .studio folder holds the mailbox and logs; keep it out of git.
prepare_studio_dir() {
  mkdir -p "$STUDIO_DIR/mail/outbox" "$STUDIO_DIR/mail/delivered" "$STUDIO_DIR/mail/held"
  if [ -d "$PROJECT_DIR/.git/info" ] && ! grep -qs '^\.studio/$' "$PROJECT_DIR/.git/info/exclude"; then
    printf '.studio/\n' >> "$PROJECT_DIR/.git/info/exclude"
  fi
}

# Is at least the architect of this project's team a live agent in Herdr?
team_is_live() {
  hd agent list 2>/dev/null | jq -e --arg n "$PROJECT_SLUG-architect" '[.result.agents[]? | select(.name == $n)] | length > 0' >/dev/null 2>&1
}

# Picking a project in the studio is the owner's trust decision for it. Record it
# the way Claude Code does, or the workers' `--worktree` sessions refuse to start
# ("Workspace trust not yet accepted") while the architect waits at the dialog.
trust_project() {
  local f="$HOME/.claude.json" tmp
  team_uses claude && [ -f "$f" ] || return 0
  # Only a git project the owner picked, never a home folder or a disk root:
  # trusting runs that folder's hooks and settings.
  case $PROJECT_DIR in "$HOME"|/|/Users|/Users/*/) return 0 ;; esac
  [ -d "$PROJECT_DIR/.git" ] || { warn "$PROJECT_DIR is not a git project, so I won't mark it trusted; Claude may ask you."; return 0; }
  # The studio home is trusted only when the studio made it; a folder that was already there is the owner's call.
  if [ "$PROJECT_DIR" = "$STUDIO_WORKSPACE" ] && [ ! -f "$STUDIO_WORKSPACE/.studio-home" ]; then return 0; fi
  jq -e --arg p "$PROJECT_DIR" '.projects[$p].hasTrustDialogAccepted == true' "$f" >/dev/null 2>&1 && return 0
  tmp=$(mktemp "$HOME/.claude.json.XXXXXX")
  if jq --arg p "$PROJECT_DIR" '.projects[$p] = ((.projects[$p] // {}) + {hasTrustDialogAccepted: true})' "$f" > "$tmp"; then
    mv "$tmp" "$f"; say "Marked $PROJECT_DIR as trusted for Claude Code."
  else
    rm -f "$tmp"; warn "Couldn't update $f; Claude may ask you to trust the folder."
  fi
}

# --- Opening the window ------------------------------------------------------------

open_window() {
  local attach
  attach=$(herdr_attach_cmd)
  # A client already attached means the studio is on screen somewhere: don't open another.
  if [ "${STUDIO_GUI:-0}" = 1 ] && pgrep -f -- "herdr --session ${STUDIO_SESSION:-x}\$" >/dev/null 2>&1; then
    say "The studio is already open on this Mac."
    return 0
  fi
  if [ "${STUDIO_GUI:-0}" != 1 ] || ! is_macos; then
    # shellcheck disable=SC2086
    exec $attach
  fi
  case ${TERMINAL_APP:-auto} in
    auto)
      # OMAC's own terminal tile first, so the studio lands in the owner's window manager.
      if command -v omac >/dev/null 2>&1 && pgrep -x OmacNative >/dev/null 2>&1; then TERMINAL_APP=omac
      elif [ -d /Applications/Ghostty.app ]; then TERMINAL_APP=ghostty
      elif [ -d /Applications/iTerm.app ]; then TERMINAL_APP=iterm
      else TERMINAL_APP=terminal; fi ;;
  esac
  # shellcheck disable=SC2086
  case $TERMINAL_APP in
    omac)
      # OMAC answers with "Opened terminal on page N" on success; anything else
      # (a paused page, a refusal) means no tile appeared, so use a Terminal window.
      if ! omac terminal "exec $attach" --title "Dev Studio" 2>&1 | grep -q '^Opened terminal'; then
        warn "OMAC couldn't open a tile right now; opening a Terminal window instead."
        osascript "$STUDIO_HOME/macos/open-terminal.applescript" "$attach" >/dev/null
      fi ;;
    ghostty) open -na Ghostty.app --args --title="Dev Studio" -e $attach ;;
    iterm)   osascript -e "tell application \"iTerm\" to create window with default profile command \"$attach\"" -e 'tell application "iTerm" to activate' ;;
    *)       osascript "$STUDIO_HOME/macos/open-terminal.applescript" "$attach" >/dev/null ;;
  esac
}

# The board as its own window next to the team: Chrome's app mode (no tabs, no
# address bar) when Chrome is installed, else the default browser. The web view
# runs under launchd; make sure it is up first.
open_board_window() {
  [ "${BOARD_WINDOW:-auto}" = none ] && return 0
  local url="http://localhost:$WEB_PORT/" chrome="/Applications/Google Chrome.app" profile="$STUDIO_DATA/board-chrome"
  curl -s -m 2 -o /dev/null "$url" || { cmd_web start >/dev/null 2>&1; sleep 1; }
  if [ -d "$chrome" ]; then
    # The board gets its own Chrome profile, so it is its own process: launching it never
    # collides with the owner's Chrome, and "is the window open?" is just "is it running?"
    # (an app-mode Chrome exits when its last window closes). LaunchServices starts it,
    # so it outlives this launcher.
    if pgrep -f -- "--user-data-dir=$profile" >/dev/null 2>&1; then return 0; fi
    mkdir -p "$profile"
    open -na "Google Chrome" --args "--user-data-dir=$profile" "--app=$url" --window-size=1500,980 \
      --no-first-run --no-default-browser-check --disable-session-crashed-bubble
  else
    open "$url"
  fi
}

# --- Commands -------------------------------------------------------------------------

# The studio's own home: a plain git folder the team works from. Projects get
# cloned or opened from inside it by the architect, so nobody has to pick files.
ensure_studio_home() {
  [ -d "$STUDIO_WORKSPACE/.git" ] && return 0
  # Claim the folder as studio-made only when it did not exist or was empty;
  # a folder with the owner's own files is theirs, and is never auto-trusted.
  if [ ! -e "$STUDIO_WORKSPACE" ] || [ -z "$(ls -A "$STUDIO_WORKSPACE" 2>/dev/null)" ]; then
    mkdir -p "$STUDIO_WORKSPACE" && touch "$STUDIO_WORKSPACE/.studio-home"
  else
    warn "$STUDIO_WORKSPACE already has files in it, so I won't mark it trusted; Claude may ask you."
  fi
  [ -f "$STUDIO_WORKSPACE/README.md" ] || printf '# Dev Studio\n\nThe team works from here. Ask the architect to clone or open a project.\n' > "$STUDIO_WORKSPACE/README.md"
  # Workers branch off this repo with `--worktree`, which needs a first commit;
  # commit only what the studio wrote.
  git -C "$STUDIO_WORKSPACE" init -q 2>/dev/null \
    && git -C "$STUDIO_WORKSPACE" add README.md .studio-home 2>/dev/null \
    && git -C "$STUDIO_WORKSPACE" -c user.name="Dev Studio" -c user.email="studio@local" commit -q -m "Dev Studio home" || true
}

# The workspace's name: "<project>-claude", "<project>-codex", or "<project>-mixed".
set_label() {
  local suffix title
  suffix=$(team_suffix)
  case $suffix in codex) title=Codex ;; claude) title=Claude ;; *) title=Mixed ;; esac
  if [ "${PROJECT_SLUG:-}" = studio ]; then WS_LABEL="Dev Studio · $title"
  else WS_LABEL="${PROJECT_SLUG:-studio}-$suffix"; fi
}

set_project() { # project-arg
  PROJECT_DIR=$(resolve_project "$1")
  [ -n "$PROJECT_DIR" ] || die "Can't find project '$1' (looked in $PROJECTS_DIR)"
  STUDIO_DIR=$PROJECT_DIR/.studio
  if [ "$PROJECT_DIR" = "$STUDIO_WORKSPACE" ]; then PROJECT_SLUG=studio
  else PROJECT_SLUG=$(slug "$(basename "$PROJECT_DIR")"); fi
  set_label
}

cmd_up() {
  local attach=1 arg='' expect='' pick=0 arg_arch='' arg_main='' arg_worker='' arg_rev='' mixed=0 n=1 k
  for a in "$@"; do
    if [ -n "$expect" ]; then
      case $expect in
        router) ROUTER=$a ;;
        architect-kind) arg_arch=$a ;;
        main-kind) arg_main=$a ;;
        worker-kind) arg_worker=$a ;;
        reviewer) arg_rev=$a ;;
      esac
      expect=''; continue
    fi
    case $a in
      --no-attach) attach=0 ;;
      --pick)   pick=1 ;;
      --codex)  AGENT_KIND=codex ;;
      --claude) AGENT_KIND=claude ;;
      --router) expect=router ;;
      --router=*) ROUTER=${a#--router=} ;;
      --architect-kind) expect=architect-kind ;;
      --architect-kind=*) arg_arch=${a#--architect-kind=} ;;
      --main-kind) expect=main-kind ;;
      --main-kind=*) arg_main=${a#--main-kind=} ;;
      --worker-kind) expect=worker-kind ;;
      --worker-kind=*) arg_worker=${a#--worker-kind=} ;;
      --workers-mixed) mixed=1 ;;
      --reviewer) expect=reviewer ;;
      --reviewer=*) arg_rev=${a#--reviewer=} ;;
      *) arg=$a ;;
    esac
  done
  [ -z "$expect" ] || die "$expect needs a value."
  # --reviewer overrides REVIEWER from studio.conf; either way the value must be a known one.
  [ -z "$arg_rev" ] || REVIEWER=$arg_rev
  case $REVIEWER in none|claude|codex) ;; *) die "Unknown reviewer '$REVIEWER' (studio.conf or --reviewer). Use codex, claude or none." ;; esac
  case $ROUTER in jev|clef|rules) ;; *) die "Unknown router '$ROUTER'. Use jev, clef or rules." ;; esac
  case $AGENT_KIND in claude|codex) ;; *) die "Unknown agent kind '$AGENT_KIND'. Use claude or codex." ;; esac
  for k in "$arg_arch" "$arg_main" "$arg_worker"; do
    case $k in ''|claude|codex) ;; *) die "Unknown agent kind '$k'. Use claude or codex." ;; esac
  done
  [ "$mixed" = 1 ] && [ -n "$arg_worker" ] && die "--workers-mixed and --worker-kind can't be used together."
  # Each role's kind: the default kind unless a flag names another. Workers either
  # share one kind, or (--workers-mixed) alternate codex, claude, codex… from worker-1.
  KIND_ARCH=${arg_arch:-$AGENT_KIND}
  KIND_MAIN=${arg_main:-$AGENT_KIND}
  KIND_WORKER=${arg_worker:-$AGENT_KIND}
  WORKERS_MIXED=$mixed
  WORKER_KINDS=''
  if [ "$mixed" = 1 ]; then
    while [ $n -le "$WORKERS" ]; do
      if [ $((n % 2)) = 1 ]; then k=codex; else k=claude; fi
      WORKER_KINDS="$WORKER_KINDS${WORKER_KINDS:+ }$k"
      n=$((n + 1))
    done
  fi
  # shellcheck disable=SC2086
  for k in $(printf '%s\n' "$KIND_ARCH" "$KIND_MAIN" "$KIND_WORKER" $WORKER_KINDS | sort -u); do
    command -v "$k" >/dev/null 2>&1 || die "$k isn't installed."
  done
  [ "$REVIEWER" = none ] || command -v "$REVIEWER" >/dev/null 2>&1 || die "$REVIEWER isn't installed."
  command -v "$HERDR" >/dev/null 2>&1 || die "Herdr isn't installed. Run: brew install herdr"
  command -v jq >/dev/null 2>&1 || die "jq isn't installed. Run: brew install jq"

  if [ -z "$arg" ] && [ $pick = 1 ]; then
    arg=$(pick_project) || exit 1
    [ -n "$arg" ] || exit 0   # picker cancelled
  elif [ -z "$arg" ]; then
    ensure_studio_home
    arg=$STUDIO_WORKSPACE
  fi
  set_project "$arg"
  pick_models "$KIND_ARCH" "$KIND_MAIN" "$KIND_WORKER"
  set_config LAST_PROJECT "$PROJECT_DIR"
  set_config AGENT_KIND "$AGENT_KIND"
  set_config ROUTER "$ROUTER"
  prepare_studio_dir
  trust_project

  ensure_server
  local ws
  ws=$(find_workspace "$WS_LABEL")
  # After a Herdr restart the workspace comes back with empty shells and no
  # agents. A space whose team is not live gets rebuilt, not reopened.
  if [ -n "$ws" ] && ! team_is_live; then
    warn "The $PROJECT_SLUG space is there but its agents are gone; rebuilding the team."
    hd workspace close "$ws" >/dev/null 2>&1 || true
    sleep 1
    ws=''
  fi
  if [ -n "$ws" ]; then
    ok "The $PROJECT_SLUG team ($(team_suffix)) is already at work. Opening it…"
  else
    say "Assembling the ${C_BOLD}$PROJECT_SLUG${C_RESET} team: ${C_BOLD}$(team_suffix)${C_RESET}, router ${C_BOLD}$ROUTER${C_RESET}…"
    fit_workers
    layout
    ws=$WS_ID
    ok "Team assembled: architect ($KIND_ARCH, $ARCH_M), main ($KIND_MAIN, $MAIN_M), $WORKERS worker(s) ($(workers_summary)), router ($ROUTER)."
    play_sound Glass
  fi
  [ -n "$ws" ] && hd workspace focus "$ws" >/dev/null 2>&1
  if [ $attach = 1 ]; then
    [ "${STUDIO_GUI:-0}" = 1 ] && is_macos && open_board_window
    open_window
  fi
  return 0
}

cmd_board() {
  local dir=${1:-$LAST_PROJECT}
  [ -n "$dir" ] || die "Which project? studio board /path/to/project"
  set_project "$dir"; load_team
  # shellcheck disable=SC2086
  exec "$PYTHON" "$STUDIO_HOME/ui/board.py" --studio "$STUDIO_DIR" --herdr "$(herdr_cli_cmd)" --kind "$(team_suffix)" \
    --kinds "$(kinds_arg)" --arch-model "$ARCH_M" --main-model "$MAIN_M" --worker-model "$WORKER_M" ${STUDIO_BOARD_ONCE:+--once}
}

# studio status [project]: who is on the team, and which CLI each one runs.
cmd_status() {
  local dir=${1:-$LAST_PROJECT} n=1 k
  [ -n "$dir" ] || die "Which project? studio status /path/to/project"
  set_project "$dir"; load_team
  printf '%s team (%s), router %s\n' "$PROJECT_SLUG" "$(team_suffix)" "$ROUTER"
  printf '  %-12s %-7s %s\n' architect "$KIND_ARCH" "$ARCH_M"
  printf '  %-12s %-7s %s\n' main "$KIND_MAIN" "$MAIN_M"
  while [ $n -le "$WORKERS" ]; do
    k=$(worker_kind "$n")
    printf '  %-12s %-7s %s\n' "worker-$n" "$k" "$(model_for "$k" worker)"
    n=$((n + 1))
  done
}

# The board as a web page, kept up by launchd (KeepAlive) on this Mac.
#   studio web            start (or restart) the web view under launchd
#   studio web serve      run it in the foreground (what launchd runs)
#   studio web stop
WEB_LABEL=dev.studio.web
cmd_web() {
  local dir=${LAST_PROJECT:-$STUDIO_WORKSPACE} plist="$HOME/Library/LaunchAgents/$WEB_LABEL.plist"
  case ${1:-start} in
    serve)
      set_project "$dir"; load_team
      exec "$PYTHON" "$STUDIO_HOME/ui/web.py" --studio "$STUDIO_DIR" --herdr "$(herdr_cli_cmd)" --kind "$(team_suffix)" \
        --kinds "$(kinds_arg)" --arch-model "$ARCH_M" --main-model "$MAIN_M" --worker-model "$WORKER_M" --port "$WEB_PORT" \
        --name "$STUDIO_NAME" ${PEER_URL:+--peer "$PEER_URL" --peer-name "$PEER_NAME"} ;;
    stop)
      launchctl bootout "gui/$(id -u)/$WEB_LABEL" >/dev/null 2>&1; ok "Web view stopped." ;;
    start)
      mkdir -p "$(dirname "$plist")" "$STUDIO_DATA/logs"
      cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$WEB_LABEL</string>
  <key>ProgramArguments</key><array><string>$STUDIO_HOME/bin/studio</string><string>web</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>HOME</key><string>$HOME</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$STUDIO_DATA/logs/web.log</string>
  <key>StandardErrorPath</key><string>$STUDIO_DATA/logs/web.log</string>
</dict></plist>
PLIST
      launchctl bootout "gui/$(id -u)/$WEB_LABEL" >/dev/null 2>&1 || true
      launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || launchctl kickstart -k "gui/$(id -u)/$WEB_LABEL"
      ok "Web view on port $WEB_PORT: http://localhost:$WEB_PORT here, and this Mac's Tailscale address from your other devices." ;;
    *) die "Usage: studio web [start|stop|serve]" ;;
  esac
}

# The router runs under this restart loop, in its own pane, so a crash is
# visible and never silent.
cmd_router() {
  local dir=${1:-$LAST_PROJECT} rc
  [ -n "$dir" ] || die "Which project? studio router /path/to/project"
  set_project "$dir"; load_team
  export ROUTER CLEF_URL
  while :; do
    "$PYTHON" "$STUDIO_HOME/router/router.py" daemon --studio "$STUDIO_DIR" --herdr "$(herdr_cli_cmd)" --review-bin "$STUDIO_HOME/bin/studio" ${STUDIO_ROUTER_ONCE:+--once}
    rc=$?
    [ "${STUDIO_ROUTER_ONCE:-0}" = 1 ] && return "$rc"
    printf '%s router exited (rc=%s); restarting in 2s. Ctrl-C to stop.\n' "$(date '+%H:%M:%S')" "$rc"
    sleep 2
  done
}

# Agents call `studio send` from inside the project (or a worktree under it), so
# the mailbox is found by walking up from the current folder. The last-opened
# project is only a fallback, so two teams on two projects never cross wires.
find_project_from_cwd() {
  local d=$PWD
  while [ "$d" != / ] && [ -n "$d" ]; do
    [ -f "$d/.studio/peers.json" ] && { printf '%s' "$d"; return 0; }
    d=$(dirname "$d")
  done
  [ -n "${LAST_PROJECT:-}" ] && printf '%s' "$LAST_PROJECT"
}

cmd_send() { # from to text...
  [ $# -ge 3 ] || die "Usage: studio send FROM @TO|auto \"note\""
  local from=$1 to=$2 dir; shift 2
  dir=$(find_project_from_cwd)
  [ -n "$dir" ] || die "No studio project here (no .studio folder above $PWD)."
  set_project "$dir"
  "$PYTHON" "$STUDIO_HOME/router/router.py" send --studio "$STUDIO_DIR" --from "$from" --to "$to" --text "$*"
}

cmd_ask() {
  local dir
  dir=$(find_project_from_cwd)
  [ -n "$dir" ] || die "No studio project here (no .studio folder above $PWD)."
  set_project "$dir"; load_team
  export ROUTER CLEF_URL
  "$PYTHON" "$STUDIO_HOME/router/router.py" ask --studio "$STUDIO_DIR" --from "${STUDIO_AGENT:-$PROJECT_SLUG-main}" --to "${STUDIO_TO:-auto}" --text "$*"
}

# The reviewer's recent pane text, unwrapped, one line per row. Empty if Herdr can't read it.
review_pane() { hd agent read "$1" --source recent-unwrapped --format text --lines 1000 2>/dev/null || true; }

# Reviews run one at a time per team. The lock is a directory under .studio whose pid file holds
# the pid of the review that owns it; a lock whose pid is gone is stale and is taken over.
review_lock() { # lock-dir seconds-to-wait -> 0 once held, 1 when the wait runs out
  local dir=$1 wait_s=$2 holder deadline
  deadline=$(( $(date +%s) + wait_s ))
  while :; do
    if mkdir "$dir" 2>/dev/null; then
      printf '%s\n' "$$" > "$dir/pid"
      return 0
    fi
    [ "$(date +%s)" -lt "$deadline" ] || return 1
    holder=$(cat "$dir/pid" 2>/dev/null || true)
    if [ -z "$holder" ] || ! kill -0 "$holder" 2>/dev/null; then
      mv "$dir" "$dir.stale.$$" 2>/dev/null && rm -rf "$dir.stale.$$"
      continue
    fi
    sleep 1
  done
}

review_unlock() { # lock-dir: release it, but only if this review holds it
  [ "$(cat "$1/pid" 2>/dev/null || true)" = "$$" ] && rm -rf "$1"
  return 0
}

# studio review <commit>: ask the team's reviewer for a verdict on one commit, then relay the
# verdict to the architect as from the reviewer. The router starts this in the background when
# a worker sends "done <commit>". It always relays something: the verdict, or
# "REVIEW <commit>: TIMEOUT" once STUDIO_REVIEW_TIMEOUT seconds pass. It never blocks anyone.
cmd_review() {
  local commit=${1:-} dir reviewer architect rev stat brief prompt out block verdict body timeout poll deadline lock nonce
  [ -n "$commit" ] || die "Usage: studio review <commit>"
  case $commit in *[!0-9a-fA-F]*) die "A commit is a hash of 7 to 40 hex characters: $commit" ;; esac
  [ ${#commit} -ge 7 ] && [ ${#commit} -le 40 ] || die "A commit is a hash of 7 to 40 hex characters: $commit"
  dir=$(find_project_from_cwd)
  [ -n "$dir" ] || die "No studio project here (no .studio folder above $PWD)."
  set_project "$dir"; load_team
  [ "$REVIEWER" != none ] || die "This team has no reviewer. Start one with: studio up --reviewer codex"
  reviewer=$PROJECT_SLUG-reviewer; architect=$PROJECT_SLUG-architect
  if [ "${STUDIO_REVIEW_FROM_ROUTER:-0}" != 1 ]; then
    # Typed by hand: the reviewer never sees this pane's seal. Ask the router instead, signed with
    # this pane's own seal (the sender is STUDIO_AGENT, default the architect), and let it start
    # the review with the reviewer's token. The router answers only verified team members.
    cmd_send "${STUDIO_AGENT:-$architect}" auto "review $commit" >/dev/null
    ok "Asked the router to review $commit. The verdict comes from $reviewer."
    return 0
  fi
  rev=$(git -C "$PROJECT_DIR" rev-parse --verify -q "$commit^{commit}" 2>/dev/null) || rev=''
  if [ -z "$rev" ]; then
    cmd_send "$reviewer" "@$architect" "REVIEW $commit: BLOCK commit $commit is not in $PROJECT_SLUG" >/dev/null
    die "No commit $commit in $PROJECT_DIR. Told the architect."
  fi
  timeout=${STUDIO_REVIEW_TIMEOUT:-900}; poll=${STUDIO_REVIEW_POLL:-15}
  # One review at a time per team. The wait for the lock is bounded like the review itself.
  lock=$STUDIO_DIR/review.lock
  if ! review_lock "$lock" "$timeout"; then
    cmd_send "$reviewer" "@$architect" "REVIEW $commit: TIMEOUT - another review was still running" >/dev/null
    ok "Told the architect: REVIEW $commit: TIMEOUT"
    return 0
  fi
  trap "review_unlock '$lock'" EXIT
  # The job brief is the commit message; the stat summary says which files moved. The nonce
  # ties this request to its own verdict, so an old verdict still on screen is never taken.
  stat=$(git -C "$PROJECT_DIR" show --stat --format= "$rev" 2>/dev/null | tail -n 25 | tr '\n' ';')
  brief=$(git -C "$PROJECT_DIR" log -1 --format=%B "$rev" 2>/dev/null | tr '\n' ' ' | cut -c 1-1200)
  nonce=r$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
  prompt="Review commit $commit of $PROJECT_SLUG (request $nonce). Job brief (the commit message): $brief Changed files: $stat Read the whole change with git show $rev. Answer with short numbered findings (bugs, risky changes, scope drift, missing tests, private data), then end with exactly one line: REVIEW $commit: PASS, CHANGES or BLOCK."
  prompt=$(printf '%s' "$prompt" | tr '\n\r\t' '   ')
  if ! hd agent prompt "$reviewer" "$prompt" >/dev/null 2>&1; then
    review_unlock "$lock"
    cmd_send "$reviewer" "@$architect" "REVIEW $commit: TIMEOUT - the reviewer did not take the review request" >/dev/null
    die "The reviewer $reviewer did not take the request for $commit. Told the architect."
  fi
  # The clock starts once the lock is held.
  deadline=$(( $(date +%s) + timeout ))
  say "Reviewing $commit with $reviewer (up to ${timeout}s)"
  while :; do
    out=$(review_pane "$reviewer")
    # Accept only a verdict line that comes after this request's nonce line.
    block=$(printf '%s\n' "$out" | awk -v id="$commit" -v nonce="$nonce" '
      { line[NR] = $0 }
      index($0, nonce) { start = NR }
      start && NR > start && index($0, "REVIEW " id ": ") && $0 ~ /(PASS|CHANGES|BLOCK)[[:space:]]*$/ { last = NR }
      END {
        if (!last) exit
        from = last - 13; if (from <= start) from = start + 1
        for (i = from; i <= last; i++) if (line[i] ~ /[^[:space:]]/) print line[i]
      }')
    [ -n "$block" ] && break
    if [ "$(date +%s)" -ge "$deadline" ]; then
      review_unlock "$lock"
      cmd_send "$reviewer" "@$architect" "REVIEW $commit: TIMEOUT" >/dev/null
      ok "Told the architect: REVIEW $commit: TIMEOUT"
      return 0
    fi
    sleep "$poll"
  done
  review_unlock "$lock"
  # The findings sit above the verdict; the verdict is the last line of the block.
  verdict=$(printf '%s\n' "$block" | tail -n 1 | sed 's/[[:space:]]*$//')
  body=$(printf '%s\n' "$block" | sed '$d' | tr '\n' ' ' | tr -s ' ' | cut -c 1-600)
  if [ -n "$body" ]; then cmd_send "$reviewer" "@$architect" "$verdict - $body" >/dev/null
  else cmd_send "$reviewer" "@$architect" "$verdict" >/dev/null; fi
  ok "Told the architect: $verdict"
}

version_at_least() { # have want
  awk -v a="$1" -v b="$2" 'BEGIN { split(a, x, "."); split(b, y, ".")
    for (i = 1; i <= 3; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 }
    exit 0 }'
}

cmd_doctor() {
  local bad=0 v
  check() { # label command hint
    if command -v "$2" >/dev/null 2>&1; then ok "$1"; else warn "$1 missing. $3"; bad=1; fi
  }
  printf '%s\n' "${C_PINK}${C_BOLD}Dev Studio checkup${C_RESET}  (agents: $(team_suffix), router: $ROUTER)"
  check "Herdr"       "$HERDR" "brew install herdr"
  check "Claude Code" claude   "https://code.claude.com/docs/en/setup"
  check "Codex"       codex    "npm install -g @openai/codex (only needed for --codex)"
  check "jq"          jq       "brew install jq"
  check "python3"     "$PYTHON" "xcode-select --install"
  check "git"         git      "xcode-select --install"
  case $ROUTER in
    jev)  if [ -n "${TYPESAFE_API_KEY:-}" ]; then ok "JEV router: TYPESAFE_API_KEY is set"
          else warn "JEV router: TYPESAFE_API_KEY is not set, so the router falls back to rules. Add it to ~/.zshrc."; bad=1; fi ;;
    clef) if [ -n "${CLEF_URL:-}" ]; then ok "Clef router: $CLEF_URL"
          else warn "Clef router: set CLEF_URL in $STUDIO_CONF (a System One-compatible endpoint)."; bad=1; fi ;;
    *)    ok "Rules router: no model, explicit addresses only" ;;
  esac
  if command -v claude >/dev/null 2>&1; then
    v=$(claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    if [ -n "$v" ] && version_at_least "$v" 2.1.224; then ok "Claude Code $v supports cross-session messaging"
    else warn "Claude Code ${v:-?} is too old for cross-session messaging. Run: claude update"; bad=1; fi
  fi
  v=$(mem_available_mb)
  ok "Memory free: ${v}MB, room for about $(( v > MEM_RESERVE_MB ? (v - MEM_RESERVE_MB) / MB_PER_AGENT : 0 )) agent sessions"
  if [ -d "$PROJECTS_DIR" ]; then ok "Projects folder: $PROJECTS_DIR ($(list_projects | wc -l | tr -d ' ') projects)"
  else warn "Projects folder $PROJECTS_DIR doesn't exist. Set PROJECTS_DIR in $STUDIO_CONF"; bad=1; fi
  [ $bad = 0 ] && ok "${C_BOLD}All good. Click the Studio icon in your Dock.${C_RESET}"
  return $bad
}

cmd_stop() {
  printf 'Stop the studio and every agent in it? [y/N] '
  read -r a
  case $a in
    y|Y|yes)
      launchctl bootout "gui/$(id -u)/$LAUNCHD_LABEL" >/dev/null 2>&1 || true   # or KeepAlive brings it straight back
      hd server stop >/dev/null 2>&1; ok "Studio stopped." ;;
    *) say "Left running." ;;
  esac
}

load_config
case ${1:-help} in
  up)     shift; cmd_up "$@" ;;
  status) shift; cmd_status "$@" ;;
  board|dash) shift; cmd_board "$@" ;;
  router) shift; cmd_router "$@" ;;
  web)    shift; cmd_web "$@" ;;
  send)   shift; cmd_send "$@" ;;
  ask)    shift; cmd_ask "$@" ;;
  review) shift; cmd_review "$@" ;;
  doctor) cmd_doctor ;;
  stop)   cmd_stop ;;
  help|-h|--help) usage ;;
  *)      usage; exit 2 ;;
esac
