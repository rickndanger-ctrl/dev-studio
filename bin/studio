#!/usr/bin/env bash
# Dev Studio: one click opens a team of coding-agent sessions in Herdr, with a
# board that shows JEV routing every message between them.
#   studio up [project] [--codex|--claude] [--router jev|clef|rules]
#   studio board          the board (runs inside the studio's first tab)
#   studio router         the message router (runs inside the studio's team tab)
#   studio send FROM TO "text"   send a peer message through the router
#   studio ask "text"     dry run: what would the router decide?
#   studio doctor         check everything is installed
#   studio stop           stop the studio's Herdr session and every agent in it
set -u

SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in /*) SELF=$link ;; *) SELF=$(dirname "$SELF")/$link ;; esac
done
STUDIO_HOME=$(cd "$(dirname "$SELF")/.." && pwd)
export STUDIO_HOME
# shellcheck source=../lib/common.sh
. "$STUDIO_HOME/lib/common.sh"

usage() {
  cat <<EOF
${C_PINK}${C_BOLD}Dev Studio${C_RESET}  your AI dev team, one click away

  studio up [--codex|--claude] [--router jev|clef|rules] [--no-attach]
                          open (or reopen) the team in the studio's home (~/DevStudio)
  studio up <project>     the team on a specific project folder; --pick shows a chooser
  studio board            the live board (what the first tab shows)
  studio send FROM TO "note"   send a peer message through the router (TO = @name or auto)
  studio ask "note"       dry run: show what the router would decide
  studio web              the board as a web page for your phone or laptop (kept up by launchd)
  studio doctor           check that everything is installed
  studio stop             stop the studio and every agent in it
EOF
}

# --- Herdr helpers -----------------------------------------------------------

# The studio's Herdr server runs under launchd with KeepAlive: a server started
# from the Dock app's launcher dies when that launcher exits a second later
# (macOS reaps the app's children), and this way it also restarts after a crash.
LAUNCHD_LABEL=dev.studio.herdr
launchd_plist() { printf '%s/Library/LaunchAgents/%s.plist' "$HOME" "$LAUNCHD_LABEL"; }

start_server_launchd() {
  local plist herdr_bin
  plist=$(launchd_plist); herdr_bin=$(command -v "$HERDR")
  mkdir -p "$(dirname "$plist")" "$STUDIO_DATA/logs"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LAUNCHD_LABEL</string>
  <key>ProgramArguments</key><array>
    <string>$herdr_bin</string><string>--session</string><string>$STUDIO_SESSION</string><string>server</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>HOME</key><string>$HOME</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$STUDIO_DATA/logs/herdr-server.log</string>
  <key>StandardErrorPath</key><string>$STUDIO_DATA/logs/herdr-server.log</string>
</dict></plist>
PLIST
  launchctl bootout "gui/$(id -u)/$LAUNCHD_LABEL" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || launchctl kickstart -k "gui/$(id -u)/$LAUNCHD_LABEL" 2>/dev/null
}

ensure_server() {
  hd workspace list >/dev/null 2>&1 && return 0
  say "Waking up Herdr…"
  mkdir -p "$STUDIO_DATA/logs"
  if [ "${STUDIO_SUPERVISOR:-launchd}" = launchd ] && [ -n "${STUDIO_SESSION:-}" ] && is_macos; then
    start_server_launchd
  else
    # nohup needs a real binary, so spell the session flag out instead of using hd.
    nohup "$HERDR" ${STUDIO_SESSION:+--session "$STUDIO_SESSION"} server >>"$STUDIO_DATA/logs/herdr-server.log" 2>&1 &
  fi
  local i=0
  while [ $i -lt 40 ]; do
    hd workspace list >/dev/null 2>&1 && return 0
    sleep 0.25; i=$((i + 1))
  done
  die "Herdr didn't start. Log: $STUDIO_DATA/logs/herdr-server.log"
}

# Print the id of the workspace with this label, if it exists.
find_workspace() {
  hd workspace list 2>/dev/null | jq -r --arg l "$1" '
    [.. | objects | select(.label? == $l or .name? == $l) | (.workspace_id // .id // empty)] | first // empty' 2>/dev/null
}

new_workspace() { # label cwd -> "workspace-id root-pane-id"
  hd workspace create --cwd "$2" --label "$1" --no-focus | jq -r '"\(.result.workspace.workspace_id) \(.result.root_pane.pane_id)"'
}

new_tab() { # workspace label cwd [env] -> root pane id
  hd tab create --workspace "$1" --label "$2" --cwd "$3" ${4:+--env "$4"} --no-focus | jq -r '.result.root_pane.pane_id'
}

split() { # pane direction new-pane-share cwd [env] -> new pane id
  # Herdr's --ratio is the share the ORIGINAL pane keeps (checked on herdr 0.9.3:
  # `split down 0.25` left the original 10 of 40 rows), so convert from the share
  # the layouts give the new pane.
  local keep
  keep=$(awk -v r="$3" 'BEGIN { printf "%.2f", 1 - r }')
  hd pane split "$1" --direction "$2" --ratio "$keep" --cwd "$4" ${5:+--env "$5"} --no-focus | jq -r '.result.pane.pane_id'
}

# Each agent's pane gets its own secret (STUDIO_TOKEN) so `studio send` can sign
# messages; only the router pane gets the whole map (STUDIO_TOKENS). Neither is
# written to disk, so an agent cannot read another agent's token from a file.
new_token() { od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }
TOKENS_JSON='{}'
issue_token() { # name -> sets TOKEN and remembers it for the router (no subshell: the map must survive)
  TOKEN=$(new_token)
  TOKENS_JSON=$(printf '%s' "$TOKENS_JSON" | jq -c --arg n "$1" --arg t "$TOKEN" '. + {($n): $t}')
}

# --- Agents --------------------------------------------------------------------

# Write this agent's role brief with the real names filled in.
role_file() { # role agent-name -> path
  local out="$STUDIO_DATA/run/$2.md"
  mkdir -p "$STUDIO_DATA/run"
  sed -e "s/<project>/$PROJECT_SLUG/g" -e "s/<me>/$2/g" -e "s#<studio-dir>#$STUDIO_DIR#g" "$STUDIO_HOME/roles/$1.md" > "$out"
  [ -f "$STUDIO_HOME/LESSONS.md" ] && { printf '\n\n'; cat "$STUDIO_HOME/LESSONS.md"; } >> "$out"
  printf '%s' "$out"
}

# Tell Herdr the agent's name once it detects the session. Herdr only knows an
# agent by its pane until it is named (herdr 0.9.3), so retry until detection.
name_agent() { # pane name
  local i=0
  while [ $i -lt 60 ]; do
    hd agent rename "$1" "$2" >/dev/null 2>&1 && return 0
    sleep 0.5; i=$((i + 1))
  done
  warn "Herdr hasn't spotted $2 yet, so its pane shows as $1 for now."
}

# start_agent pane label role name model [worktree]
start_agent() {
  local pane=$1 label=$2 role=$3 name=$4 model=$5 worktree=${6:-} brief cmd
  brief=$(role_file "$role" "$name")
  if [ "$AGENT_KIND" = codex ]; then
    # Codex has no system-prompt flag: the role brief is its first prompt.
    cmd="codex -m $model $(printf %q "You are $name. Read $brief now and follow it as your role for this whole session. Then say which role you have and wait.")"
  else
    cmd="claude --name $name --model $model"
    [ -n "$worktree" ] && cmd="$cmd --worktree $worktree"
    cmd="$cmd --settings $(printf %q "$STUDIO_HOME/settings/peer.json")"
    cmd="$cmd --append-system-prompt-file $(printf %q "$brief")"
  fi
  hd pane rename "$pane" "$label" >/dev/null 2>&1 || true
  hd pane run "$pane" "$cmd" >/dev/null
  name_agent "$pane" "$name"
}

start_pane_cmd() { # pane label command
  hd pane rename "$1" "$2" >/dev/null 2>&1 || true
  hd pane run "$1" "$3" >/dev/null
}

# The router and board need to know who is on the team and what each one does.
write_peers() {
  local n=1 json
  json="{\"$PROJECT_SLUG-architect\":{\"role\":\"architect: plans, audits, signs off before merge\",\"model\":\"$ARCH_M\"},"
  json="$json\"$PROJECT_SLUG-main\":{\"role\":\"main session: builds the feature, syncs schemas, patches dependents\",\"model\":\"$MAIN_M\"}"
  while [ $n -le "$WORKERS" ]; do
    json="$json,\"$PROJECT_SLUG-worker-$n\":{\"role\":\"worker $n: small delegated tasks in its own worktree\",\"model\":\"$WORKER_M\"}"
    n=$((n + 1))
  done
  printf '%s}\n' "$json" | jq . > "$STUDIO_DIR/peers.json"
  jq -n --arg k "$AGENT_KIND" --arg r "$ROUTER" --arg a "$ARCH_M" --arg m "$MAIN_M" --arg w "$WORKER_M" --argjson n "$WORKERS" \
    '{kind: $k, router: $r, arch_model: $a, main_model: $m, worker_model: $w, workers: $n}' > "$STUDIO_DIR/team.json"
}

# A project's team (kind, router, models) is what was launched for it, not
# whatever the config says now: another project may have been opened since.
load_team() {
  [ -f "$STUDIO_DIR/team.json" ] || return 0
  AGENT_KIND=$(jq -r .kind "$STUDIO_DIR/team.json")
  ROUTER=$(jq -r .router "$STUDIO_DIR/team.json")
  ARCH_M=$(jq -r .arch_model "$STUDIO_DIR/team.json")
  MAIN_M=$(jq -r .main_model "$STUDIO_DIR/team.json")
  WORKER_M=$(jq -r .worker_model "$STUDIO_DIR/team.json")
  WS_LABEL="$PROJECT_SLUG-$AGENT_KIND"
}

# --- Layout ------------------------------------------------------------------------

# Cap workers so the whole team fits in the memory that's free right now.
fit_workers() {
  local avail per=${MB_PER_AGENT:-600} others=2 max
  avail=$(mem_available_mb)
  case $avail in ''|*[!0-9]*) return 0 ;; esac
  max=$(( (avail - ${MEM_RESERVE_MB:-1536}) / per - others ))
  [ "$max" -lt 1 ] && max=1
  if [ "$WORKERS" -gt "$max" ]; then
    warn "Only ${avail}MB of memory free, so starting $max worker(s) instead of $WORKERS."
    WORKERS=$max
  fi
}

# Tab 1 "board": the picture.   Tab 2 "team": the terminals.
#  ┌──────────────┬──────────────┐
#  │              │ main         │
#  │ architect    ├──────────────┤
#  │              │ worker-1     │
#  ├──────────────┼──────────────┤
#  │ router       │ worker-2 …   │
#  └──────────────┴──────────────┘
layout() {
  local ws root team col router pane next n=1 left TOKEN
  # shellcheck disable=SC2046
  set -- $(new_workspace "$WS_LABEL" "$PROJECT_DIR")
  ws=$1; root=$2
  hd tab rename "$ws:t1" board >/dev/null 2>&1 || true
  start_pane_cmd "$root" "board" "$(printf %q "$STUDIO_HOME/bin/studio") board $(printf %q "$PROJECT_DIR")"
  issue_token "$PROJECT_SLUG-architect"
  team=$(new_tab "$ws" team "$PROJECT_DIR" "STUDIO_TOKEN=$TOKEN")
  issue_token "$PROJECT_SLUG-main"
  col=$(split "$team" right 0.45 "$PROJECT_DIR" "STUDIO_TOKEN=$TOKEN")
  write_peers
  start_agent "$team" "architect · $ARCH_M" architect "$PROJECT_SLUG-architect" "$ARCH_M"
  start_agent "$col" "main · $MAIN_M" main "$PROJECT_SLUG-main" "$MAIN_M"
  pane=$col
  while [ $n -le "$WORKERS" ]; do
    left=$((WORKERS - n + 1))
    issue_token "$PROJECT_SLUG-worker-$n"
    next=$(split "$pane" down "$(awk -v l="$left" 'BEGIN{printf "%.2f", l/(l+1)}')" "$PROJECT_DIR" "STUDIO_TOKEN=$TOKEN")
    start_agent "$next" "worker-$n · $WORKER_M" worker "$PROJECT_SLUG-worker-$n" "$WORKER_M" "worker-$n"
    pane=$next
    n=$((n + 1))
  done
  # The router pane is split last so its environment can carry every token.
  router=$(split "$team" down 0.25 "$PROJECT_DIR" "STUDIO_TOKENS=$TOKENS_JSON")
  start_pane_cmd "$router" "router · $ROUTER" "$(printf %q "$STUDIO_HOME/bin/studio") router $(printf %q "$PROJECT_DIR")"
  WS_ID=$ws
}

# --- Picking a project -------------------------------------------------------------

list_projects() {
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -mindepth 2 -maxdepth 2 -name .git 2>/dev/null \
    | sed 's#/\.git$##' | xargs -I{} basename {} | sort -f
}

pick_project() {
  local choice='' projects default
  projects=$(list_projects)
  default=${LAST_PROJECT:+$(basename "$LAST_PROJECT")}
  if [ "${STUDIO_GUI:-0}" = 1 ] && is_macos; then
    [ -n "$projects" ] || die "No git projects found in $PROJECTS_DIR"
    choice=$(osascript "$STUDIO_HOME/macos/pick-project.applescript" "$projects" "$default" 2>/dev/null)
    [ -n "$choice" ] || exit 0   # cancelled
  elif [ ! -t 0 ] || [ -z "$projects" ]; then
    choice=$default
  else
    printf '%s\n' "${C_PINK}${C_BOLD}Which project?${C_RESET}"
    printf '%s\n' "$projects" | awk '{printf "  %2d) %s\n", NR, $0}'
    printf 'Number or name%s: ' "${default:+ [$default]}"
    read -r choice
    [ -z "$choice" ] && choice=$default
    case $choice in
      ''|*[!0-9]*) ;;
      *) choice=$(printf '%s\n' "$projects" | sed -n "${choice}p") ;;
    esac
  fi
  [ -n "$choice" ] || die "No project chosen."
  printf '%s' "$choice"
}

resolve_project() {
  case $1 in
    /*|./*|../*|~*) (cd "$1" 2>/dev/null && pwd) ;;
    *) [ -d "$PROJECTS_DIR/$1" ] && (cd "$PROJECTS_DIR/$1" && pwd) ;;
  esac
}

# The project's .studio folder holds the mailbox and logs; keep it out of git.
prepare_studio_dir() {
  mkdir -p "$STUDIO_DIR/mail/outbox" "$STUDIO_DIR/mail/delivered" "$STUDIO_DIR/mail/held"
  if [ -d "$PROJECT_DIR/.git/info" ] && ! grep -qs '^\.studio/$' "$PROJECT_DIR/.git/info/exclude"; then
    printf '.studio/\n' >> "$PROJECT_DIR/.git/info/exclude"
  fi
}

# Is at least the architect of this project's team a live agent in Herdr?
team_is_live() {
  hd agent list 2>/dev/null | jq -e --arg n "$PROJECT_SLUG-architect" '[.result.agents[]? | select(.name == $n)] | length > 0' >/dev/null 2>&1
}

# Picking a project in the studio is the owner's trust decision for it. Record it
# the way Claude Code does, or the workers' `--worktree` sessions refuse to start
# ("Workspace trust not yet accepted") while the architect waits at the dialog.
trust_project() {
  local f="$HOME/.claude.json" tmp
  [ "$AGENT_KIND" = claude ] && [ -f "$f" ] || return 0
  # Only a git project the owner picked, never a home folder or a disk root:
  # trusting runs that folder's hooks and settings.
  case $PROJECT_DIR in "$HOME"|/|/Users|/Users/*/) return 0 ;; esac
  [ -d "$PROJECT_DIR/.git" ] || { warn "$PROJECT_DIR is not a git project, so I won't mark it trusted; Claude may ask you."; return 0; }
  # The studio home is trusted only when the studio made it; a folder that was already there is the owner's call.
  if [ "$PROJECT_DIR" = "$STUDIO_WORKSPACE" ] && [ ! -f "$STUDIO_WORKSPACE/.studio-home" ]; then return 0; fi
  jq -e --arg p "$PROJECT_DIR" '.projects[$p].hasTrustDialogAccepted == true' "$f" >/dev/null 2>&1 && return 0
  tmp=$(mktemp "$HOME/.claude.json.XXXXXX")
  if jq --arg p "$PROJECT_DIR" '.projects[$p] = ((.projects[$p] // {}) + {hasTrustDialogAccepted: true})' "$f" > "$tmp"; then
    mv "$tmp" "$f"; say "Marked $PROJECT_DIR as trusted for Claude Code."
  else
    rm -f "$tmp"; warn "Couldn't update $f; Claude may ask you to trust the folder."
  fi
}

# --- Opening the window ------------------------------------------------------------

open_window() {
  local attach
  attach=$(herdr_attach_cmd)
  if [ "${STUDIO_GUI:-0}" != 1 ] || ! is_macos; then
    # shellcheck disable=SC2086
    exec $attach
  fi
  case ${TERMINAL_APP:-auto} in
    auto)
      # OMAC's own terminal tile first, so the studio lands in the owner's window manager.
      if command -v omac >/dev/null 2>&1 && pgrep -x OmacNative >/dev/null 2>&1; then TERMINAL_APP=omac
      elif [ -d /Applications/Ghostty.app ]; then TERMINAL_APP=ghostty
      elif [ -d /Applications/iTerm.app ]; then TERMINAL_APP=iterm
      else TERMINAL_APP=terminal; fi ;;
  esac
  # shellcheck disable=SC2086
  case $TERMINAL_APP in
    omac)
      # OMAC answers with "Opened terminal on page N" on success; anything else
      # (a paused page, a refusal) means no tile appeared, so use a Terminal window.
      if ! omac terminal "exec $attach" --title "Dev Studio" 2>&1 | grep -q '^Opened terminal'; then
        warn "OMAC couldn't open a tile right now; opening a Terminal window instead."
        osascript "$STUDIO_HOME/macos/open-terminal.applescript" "$attach" >/dev/null
      fi ;;
    ghostty) open -na Ghostty.app --args --title="Dev Studio" -e $attach ;;
    iterm)   osascript -e "tell application \"iTerm\" to create window with default profile command \"$attach\"" -e 'tell application "iTerm" to activate' ;;
    *)       osascript "$STUDIO_HOME/macos/open-terminal.applescript" "$attach" >/dev/null ;;
  esac
}

# The board as its own window next to the team: Chrome's app mode (no tabs, no
# address bar) when Chrome is installed, else the default browser. The web view
# runs under launchd; make sure it is up first.
open_board_window() {
  [ "${BOARD_WINDOW:-auto}" = none ] && return 0
  local url="http://localhost:$WEB_PORT/" chrome="/Applications/Google Chrome.app" profile="$STUDIO_DATA/board-chrome"
  curl -s -m 2 -o /dev/null "$url" || { cmd_web start >/dev/null 2>&1; sleep 1; }
  if [ -d "$chrome" ]; then
    # The board gets its own Chrome profile, so it is its own process: launching it never
    # collides with the owner's Chrome, and "is the window open?" is just "is it running?"
    # (an app-mode Chrome exits when its last window closes). LaunchServices starts it,
    # so it outlives this launcher.
    if pgrep -f -- "--user-data-dir=$profile" >/dev/null 2>&1; then return 0; fi
    mkdir -p "$profile"
    open -na "Google Chrome" --args "--user-data-dir=$profile" "--app=$url" --window-size=1500,980 \
      --no-first-run --no-default-browser-check --disable-session-crashed-bubble
  else
    open "$url"
  fi
}

# --- Commands -------------------------------------------------------------------------

# Models for the chosen agent kind.
pick_models() {
  if [ "$AGENT_KIND" = codex ]; then
    ARCH_M=$CODEX_ARCHITECT_MODEL; MAIN_M=$CODEX_MAIN_MODEL; WORKER_M=$CODEX_WORKER_MODEL
  else
    ARCH_M=$ARCHITECT_MODEL; MAIN_M=$MAIN_MODEL; WORKER_M=$WORKER_MODEL
  fi
}

# The studio's own home: a plain git folder the team works from. Projects get
# cloned or opened from inside it by the architect, so nobody has to pick files.
ensure_studio_home() {
  [ -d "$STUDIO_WORKSPACE/.git" ] && return 0
  # Claim the folder as studio-made only when it did not exist or was empty;
  # a folder with the owner's own files is theirs, and is never auto-trusted.
  if [ ! -e "$STUDIO_WORKSPACE" ] || [ -z "$(ls -A "$STUDIO_WORKSPACE" 2>/dev/null)" ]; then
    mkdir -p "$STUDIO_WORKSPACE" && touch "$STUDIO_WORKSPACE/.studio-home"
  else
    warn "$STUDIO_WORKSPACE already has files in it, so I won't mark it trusted; Claude may ask you."
  fi
  [ -f "$STUDIO_WORKSPACE/README.md" ] || printf '# Dev Studio\n\nThe team works from here. Ask the architect to clone or open a project.\n' > "$STUDIO_WORKSPACE/README.md"
  # Workers branch off this repo with `--worktree`, which needs a first commit;
  # commit only what the studio wrote.
  git -C "$STUDIO_WORKSPACE" init -q 2>/dev/null \
    && git -C "$STUDIO_WORKSPACE" add README.md .studio-home 2>/dev/null \
    && git -C "$STUDIO_WORKSPACE" -c user.name="Dev Studio" -c user.email="studio@local" commit -q -m "Dev Studio home" || true
}

kind_title() { case $AGENT_KIND in codex) printf 'Codex' ;; *) printf 'Claude' ;; esac; }

set_project() { # project-arg
  PROJECT_DIR=$(resolve_project "$1")
  [ -n "$PROJECT_DIR" ] || die "Can't find project '$1' (looked in $PROJECTS_DIR)"
  STUDIO_DIR=$PROJECT_DIR/.studio
  if [ "$PROJECT_DIR" = "$STUDIO_WORKSPACE" ]; then
    PROJECT_SLUG=studio
    WS_LABEL="Dev Studio · $(kind_title)"
  else
    PROJECT_SLUG=$(slug "$(basename "$PROJECT_DIR")")
    WS_LABEL="$PROJECT_SLUG-$AGENT_KIND"
  fi
}

cmd_up() {
  local attach=1 arg='' expect='' pick=0
  for a in "$@"; do
    if [ -n "$expect" ]; then ROUTER=$a; expect=''; continue; fi
    case $a in
      --no-attach) attach=0 ;;
      --pick)   pick=1 ;;
      --codex)  AGENT_KIND=codex ;;
      --claude) AGENT_KIND=claude ;;
      --router) expect=router ;;
      --router=*) ROUTER=${a#--router=} ;;
      *) arg=$a ;;
    esac
  done
  case $ROUTER in jev|clef|rules) ;; *) die "Unknown router '$ROUTER'. Use jev, clef or rules." ;; esac
  case $AGENT_KIND in claude|codex) ;; *) die "Unknown agent kind '$AGENT_KIND'. Use claude or codex." ;; esac
  command -v "$HERDR" >/dev/null 2>&1 || die "Herdr isn't installed. Run: brew install herdr"
  command -v jq >/dev/null 2>&1 || die "jq isn't installed. Run: brew install jq"
  command -v "$AGENT_KIND" >/dev/null 2>&1 || die "$AGENT_KIND isn't installed."

  if [ -z "$arg" ] && [ $pick = 1 ]; then
    arg=$(pick_project) || exit 1
    [ -n "$arg" ] || exit 0   # picker cancelled
  elif [ -z "$arg" ]; then
    ensure_studio_home
    arg=$STUDIO_WORKSPACE
  fi
  set_project "$arg"
  pick_models
  set_config LAST_PROJECT "$PROJECT_DIR"
  set_config AGENT_KIND "$AGENT_KIND"
  set_config ROUTER "$ROUTER"
  prepare_studio_dir
  trust_project

  ensure_server
  local ws
  ws=$(find_workspace "$WS_LABEL")
  # After a Herdr restart the workspace comes back with empty shells and no
  # agents. A space whose team is not live gets rebuilt, not reopened.
  if [ -n "$ws" ] && ! team_is_live; then
    warn "The $PROJECT_SLUG space is there but its agents are gone; rebuilding the team."
    hd workspace close "$ws" >/dev/null 2>&1 || true
    sleep 1
    ws=''
  fi
  if [ -n "$ws" ]; then
    ok "The $PROJECT_SLUG team ($AGENT_KIND) is already at work. Opening it…"
  else
    say "Assembling the ${C_BOLD}$PROJECT_SLUG${C_RESET} team: ${C_BOLD}$AGENT_KIND${C_RESET}, router ${C_BOLD}$ROUTER${C_RESET}…"
    fit_workers
    layout
    ws=$WS_ID
    ok "Team assembled: architect ($ARCH_M), main ($MAIN_M), $WORKERS worker(s) ($WORKER_M), router ($ROUTER)."
    play_sound Glass
  fi
  [ -n "$ws" ] && hd workspace focus "$ws" >/dev/null 2>&1
  if [ $attach = 1 ]; then
    [ "${STUDIO_GUI:-0}" = 1 ] && is_macos && open_board_window
    open_window
  fi
  return 0
}

cmd_board() {
  local dir=${1:-$LAST_PROJECT}
  [ -n "$dir" ] || die "Which project? studio board /path/to/project"
  set_project "$dir"; pick_models; load_team
  # shellcheck disable=SC2086
  exec "$PYTHON" "$STUDIO_HOME/ui/board.py" --studio "$STUDIO_DIR" --herdr "$(herdr_cli_cmd)" --kind "$AGENT_KIND" \
    --arch-model "$ARCH_M" --main-model "$MAIN_M" --worker-model "$WORKER_M" ${STUDIO_BOARD_ONCE:+--once}
}

# The board as a web page, kept up by launchd (KeepAlive) on this Mac.
#   studio web            start (or restart) the web view under launchd
#   studio web serve      run it in the foreground (what launchd runs)
#   studio web stop
WEB_LABEL=dev.studio.web
cmd_web() {
  local dir=${LAST_PROJECT:-$STUDIO_WORKSPACE} plist="$HOME/Library/LaunchAgents/$WEB_LABEL.plist"
  case ${1:-start} in
    serve)
      set_project "$dir"; pick_models; load_team
      exec "$PYTHON" "$STUDIO_HOME/ui/web.py" --studio "$STUDIO_DIR" --herdr "$(herdr_cli_cmd)" --kind "$AGENT_KIND" \
        --arch-model "$ARCH_M" --main-model "$MAIN_M" --worker-model "$WORKER_M" --port "$WEB_PORT" \
        --name "$STUDIO_NAME" ${PEER_URL:+--peer "$PEER_URL" --peer-name "$PEER_NAME"} ;;
    stop)
      launchctl bootout "gui/$(id -u)/$WEB_LABEL" >/dev/null 2>&1; ok "Web view stopped." ;;
    start)
      mkdir -p "$(dirname "$plist")" "$STUDIO_DATA/logs"
      cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$WEB_LABEL</string>
  <key>ProgramArguments</key><array><string>$STUDIO_HOME/bin/studio</string><string>web</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>HOME</key><string>$HOME</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$STUDIO_DATA/logs/web.log</string>
  <key>StandardErrorPath</key><string>$STUDIO_DATA/logs/web.log</string>
</dict></plist>
PLIST
      launchctl bootout "gui/$(id -u)/$WEB_LABEL" >/dev/null 2>&1 || true
      launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || launchctl kickstart -k "gui/$(id -u)/$WEB_LABEL"
      ok "Web view on port $WEB_PORT: http://localhost:$WEB_PORT here, and this Mac's Tailscale address from your other devices." ;;
    *) die "Usage: studio web [start|stop|serve]" ;;
  esac
}

# The router runs under this restart loop, in its own pane, so a crash is
# visible and never silent.
cmd_router() {
  local dir=${1:-$LAST_PROJECT} rc
  [ -n "$dir" ] || die "Which project? studio router /path/to/project"
  set_project "$dir"; load_team
  export ROUTER CLEF_URL
  while :; do
    "$PYTHON" "$STUDIO_HOME/router/router.py" daemon --studio "$STUDIO_DIR" --herdr "$(herdr_cli_cmd)" ${STUDIO_ROUTER_ONCE:+--once}
    rc=$?
    [ "${STUDIO_ROUTER_ONCE:-0}" = 1 ] && return "$rc"
    printf '%s router exited (rc=%s); restarting in 2s. Ctrl-C to stop.\n' "$(date '+%H:%M:%S')" "$rc"
    sleep 2
  done
}

# Agents call `studio send` from inside the project (or a worktree under it), so
# the mailbox is found by walking up from the current folder. The last-opened
# project is only a fallback, so two teams on two projects never cross wires.
find_project_from_cwd() {
  local d=$PWD
  while [ "$d" != / ] && [ -n "$d" ]; do
    [ -f "$d/.studio/peers.json" ] && { printf '%s' "$d"; return 0; }
    d=$(dirname "$d")
  done
  [ -n "${LAST_PROJECT:-}" ] && printf '%s' "$LAST_PROJECT"
}

cmd_send() { # from to text...
  [ $# -ge 3 ] || die "Usage: studio send FROM @TO|auto \"note\""
  local from=$1 to=$2 dir; shift 2
  dir=$(find_project_from_cwd)
  [ -n "$dir" ] || die "No studio project here (no .studio folder above $PWD)."
  set_project "$dir"
  "$PYTHON" "$STUDIO_HOME/router/router.py" send --studio "$STUDIO_DIR" --from "$from" --to "$to" --text "$*"
}

cmd_ask() {
  local dir
  dir=$(find_project_from_cwd)
  [ -n "$dir" ] || die "No studio project here (no .studio folder above $PWD)."
  set_project "$dir"; load_team
  export ROUTER CLEF_URL
  "$PYTHON" "$STUDIO_HOME/router/router.py" ask --studio "$STUDIO_DIR" --from "${STUDIO_AGENT:-$PROJECT_SLUG-main}" --to "${STUDIO_TO:-auto}" --text "$*"
}

version_at_least() { # have want
  awk -v a="$1" -v b="$2" 'BEGIN { split(a, x, "."); split(b, y, ".")
    for (i = 1; i <= 3; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 }
    exit 0 }'
}

cmd_doctor() {
  local bad=0 v
  check() { # label command hint
    if command -v "$2" >/dev/null 2>&1; then ok "$1"; else warn "$1 missing. $3"; bad=1; fi
  }
  printf '%s\n' "${C_PINK}${C_BOLD}Dev Studio checkup${C_RESET}  (agents: $AGENT_KIND, router: $ROUTER)"
  check "Herdr"       "$HERDR" "brew install herdr"
  check "Claude Code" claude   "https://code.claude.com/docs/en/setup"
  check "Codex"       codex    "npm install -g @openai/codex (only needed for --codex)"
  check "jq"          jq       "brew install jq"
  check "python3"     "$PYTHON" "xcode-select --install"
  check "git"         git      "xcode-select --install"
  case $ROUTER in
    jev)  if [ -n "${TYPESAFE_API_KEY:-}" ]; then ok "JEV router: TYPESAFE_API_KEY is set"
          else warn "JEV router: TYPESAFE_API_KEY is not set, so the router falls back to rules. Add it to ~/.zshrc."; bad=1; fi ;;
    clef) if [ -n "${CLEF_URL:-}" ]; then ok "Clef router: $CLEF_URL"
          else warn "Clef router: set CLEF_URL in $STUDIO_CONF (a System One-compatible endpoint)."; bad=1; fi ;;
    *)    ok "Rules router: no model, explicit addresses only" ;;
  esac
  if command -v claude >/dev/null 2>&1; then
    v=$(claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    if [ -n "$v" ] && version_at_least "$v" 2.1.224; then ok "Claude Code $v supports cross-session messaging"
    else warn "Claude Code ${v:-?} is too old for cross-session messaging. Run: claude update"; bad=1; fi
  fi
  v=$(mem_available_mb)
  ok "Memory free: ${v}MB, room for about $(( v > MEM_RESERVE_MB ? (v - MEM_RESERVE_MB) / MB_PER_AGENT : 0 )) agent sessions"
  if [ -d "$PROJECTS_DIR" ]; then ok "Projects folder: $PROJECTS_DIR ($(list_projects | wc -l | tr -d ' ') projects)"
  else warn "Projects folder $PROJECTS_DIR doesn't exist. Set PROJECTS_DIR in $STUDIO_CONF"; bad=1; fi
  [ $bad = 0 ] && ok "${C_BOLD}All good. Click the Studio icon in your Dock.${C_RESET}"
  return $bad
}

cmd_stop() {
  printf 'Stop the studio and every agent in it? [y/N] '
  read -r a
  case $a in
    y|Y|yes)
      launchctl bootout "gui/$(id -u)/$LAUNCHD_LABEL" >/dev/null 2>&1 || true   # or KeepAlive brings it straight back
      hd server stop >/dev/null 2>&1; ok "Studio stopped." ;;
    *) say "Left running." ;;
  esac
}

load_config
case ${1:-help} in
  up)     shift; cmd_up "$@" ;;
  board|dash) shift; cmd_board "$@" ;;
  router) shift; cmd_router "$@" ;;
  web)    shift; cmd_web "$@" ;;
  send)   shift; cmd_send "$@" ;;
  ask)    shift; cmd_ask "$@" ;;
  doctor) cmd_doctor ;;
  stop)   cmd_stop ;;
  help|-h|--help) usage ;;
  *)      usage; exit 2 ;;
esac
