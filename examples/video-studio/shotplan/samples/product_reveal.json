{
  "id": "product_reveal",
  "name": "Product reveal",
  "fps": 24,
  "width": 1280,
  "height": 720,
  "shots": [
    {
      "id": "hero",
      "image": "placeholder:product hero",
      "sequence": {"segments": [{"preset": "dolly_in", "duration_s": 2}]},
      "duration": 2,
      "transition": {"crossfade": 0.5}
    },
    {
      "id": "orbit",
      "image": "placeholder:product from the side",
      "sequence": {"segments": [{"preset": "orbit_left", "duration_s": 2}]},
      "duration": 2,
      "transition": {"crossfade": 0.5}
    },
    {
      "id": "logo",
      "image": "placeholder:logo card",
      "sequence": {"segments": [
        {"preset": "crane_up", "duration_s": 1},
        {"preset": "tilt_up", "duration_s": 1}
      ]},
      "duration": 2,
      "transition": "cut"
    }
  ]
}
