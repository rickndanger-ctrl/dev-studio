#!/usr/bin/env bash
# Stand-in for the herdr CLI. JSON shapes copied from real herdr 0.9.3 replies (2026-10-27).
# Logs every call to $MOCK_LOG so tests can check what the studio asked Herdr to do.
set -u
: "${MOCK_STATE:?}" "${MOCK_LOG:?}"
printf '%s\n' "$*" >> "$MOCK_LOG"
[ "${1:-}" = --session ] && shift 2
# "Server down" mode: touch $MOCK_STATE.down and every command fails until
# `herdr server` is started, which stays up like the real one.
if [ -f "$MOCK_STATE.down" ]; then
  if [ "${1:-}" = server ]; then rm -f "$MOCK_STATE.down"; sleep 3; exit 0; fi
  echo '{"error":{"code":"server_not_running"}}' >&2; exit 1
fi
touch "$MOCK_STATE"
count() { grep -c "^$1 " "$MOCK_STATE" 2>/dev/null || true; }

case "$1 ${2:-}" in
  "workspace list")
    jq -n --rawfile s "$MOCK_STATE" '{result: {workspaces: [$s | split("\n")[] | select(startswith("ws ")) | split(" ") | {workspace_id: .[1], label: .[2]}]}}' ;;
  "workspace create")
    n=$(( $(count ws) + 1 )); label=''
    while [ $# -gt 0 ]; do [ "$1" = --label ] && label=$2; shift; done
    echo "ws w$n $label" >> "$MOCK_STATE"; echo "pane w$n:p1" >> "$MOCK_STATE"
    jq -n --arg w "w$n" --arg l "$label" '{result: {workspace: {workspace_id: $w, label: $l}, tab: {tab_id: ($w + ":t1")}, root_pane: {pane_id: ($w + ":p1")}}}' ;;
  "tab create")
    ws=''; while [ $# -gt 0 ]; do [ "$1" = --workspace ] && ws=$2; shift; done
    n=$(( $(grep -c "^pane $ws:" "$MOCK_STATE") + 1 )); t=$(( $(grep -c "^tab $ws:" "$MOCK_STATE") + 2 ))
    echo "tab $ws:t$t" >> "$MOCK_STATE"; echo "pane $ws:p$n" >> "$MOCK_STATE"
    jq -n --arg t "$ws:t$t" --arg p "$ws:p$n" '{result: {tab: {tab_id: $t}, root_pane: {pane_id: $p}}}' ;;
  "pane split")
    ws=${3%%:*}; n=$(( $(grep -c "^pane $ws:" "$MOCK_STATE") + 1 ))
    echo "pane $ws:p$n" >> "$MOCK_STATE"
    jq -n --arg p "$ws:p$n" '{result: {pane: {pane_id: $p}}}' ;;
  "agent list")
    echo '{"id":"cli:agent:list","result":{"type":"agent_list","agents":[{"agent":"claude","agent_status":"working","name":"omac-architect","pane_id":"w1:p2","workspace_id":"w1"},{"agent":"claude","agent_status":"blocked","name":"omac-main","pane_id":"w1:p4","workspace_id":"w1"},{"agent":"claude","agent_status":"idle","name":"omac-worker-1","pane_id":"w1:p5","workspace_id":"w1"},{"agent":"claude","agent_status":"done","pane_id":"w1:p6","workspace_id":"w1"}]}}' ;;
  "agent rename")
    jq -n --arg p "$3" --arg n "$4" '{result: {type: "agent_info", agent: {agent: "claude", agent_status: "idle", name: $n, pane_id: $p}}}' ;;
  "agent prompt")
    case $3 in
      *blocked*) echo '{"error":{"code":"agent_blocked","message":"agent is blocked"}}' >&2; exit 1 ;;
      *) jq -n --arg n "$3" '{result: {type: "ok", agent: $n}}' ;;
    esac ;;
  *) echo '{"result":{}}' ;;
esac
