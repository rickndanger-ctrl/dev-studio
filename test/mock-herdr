#!/usr/bin/env bash
# Stand-in for the herdr CLI, following the JSON shapes in herdr.dev/docs/agent-automation.
# Logs every call to $MOCK_LOG so tests can check what the studio asked Herdr to do.
set -u
: "${MOCK_STATE:?}" "${MOCK_LOG:?}"
printf '%s\n' "$*" >> "$MOCK_LOG"
touch "$MOCK_STATE"
count() { grep -c "^$1 " "$MOCK_STATE" 2>/dev/null || true; }

case "$1 ${2:-}" in
  "workspace list")
    jq -n --rawfile s "$MOCK_STATE" '{result: {workspaces: [$s | split("\n")[] | select(startswith("ws ")) | split(" ") | {workspace_id: .[1], label: .[2]}]}}' ;;
  "workspace create")
    n=$(( $(count ws) + 1 )); label=''
    while [ $# -gt 0 ]; do [ "$1" = --label ] && label=$2; shift; done
    echo "ws w$n $label" >> "$MOCK_STATE"; echo "pane w$n:p1" >> "$MOCK_STATE"
    jq -n --arg w "w$n" --arg l "$label" '{result: {workspace: {workspace_id: $w, label: $l}, tab: {}, root_pane: {pane_id: ($w + ":p1")}}}' ;;
  "pane split")
    ws=${3%%:*}; n=$(( $(grep -c "^pane $ws:" "$MOCK_STATE") + 1 ))
    echo "pane $ws:p$n" >> "$MOCK_STATE"
    jq -n --arg p "$ws:p$n" '{result: {pane: {pane_id: $p}}}' ;;
  "agent list")  # shape copied from a real herdr 0.9.3 reply (2026-10-27)
    echo '{"id":"cli:agent:list","result":{"type":"agent_list","agents":[{"agent":"claude","agent_status":"working","name":"omac-architect","pane_id":"w1:p1","workspace_id":"w1"},{"agent":"claude","agent_status":"blocked","name":"omac-messenger","pane_id":"w1:p3","workspace_id":"w1"},{"agent":"claude","agent_status":"done","pane_id":"w2:p1","workspace_id":"w2"}]}}' ;;
  "agent rename")
    jq -n --arg p "$3" --arg n "$4" '{result: {type: "agent_info", agent: {agent: "claude", agent_status: "idle", name: $n, pane_id: $p}}}' ;;
  *) echo '{"result":{}}' ;;
esac
