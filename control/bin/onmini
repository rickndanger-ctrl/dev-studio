#!/usr/bin/env bash
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  printf '%s\n' 'Run a script from stdin on a Mini machine'
  exit 0
fi
# Run a script (from stdin) on a Mini: onmini m1|m2 < script.sh
# Routes (SSH hosts, jump hops, fallbacks) come from the machine config via lib/re_studio_config.py.
set -u
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
t="${1:-}"
[ -n "$t" ] || { echo "usage: onmini <machine-id> < script" >&2; exit 2; }
B=$(base64 -w0)
exec python3 "$HERE/../lib/re_studio_config.py" run "$t" "echo $B | base64 -d | bash"
