#!/usr/bin/env bash
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  printf '%s\n' 'Export tracked files as a one-commit repo, checking them against a privacy word list.'
  exit 0
fi
# Export this repo's tracked files as a fresh one-commit git repo, ready to push to a public remote.
#
#   bin/publish-export <outdir>
#
# Copies `git ls-files` (tracked files only: never untracked or ignored ones), runs git init, and makes ONE
# commit, 'Initial public release', authored and committed as "re-studio <re-studio@users.noreply.github.com>"
# (override with PUBLISH_NAME / PUBLISH_EMAIL). Before it returns it checks the export:
#   - test/privacy.sh on the export's files, with the word list (never copied into the export)
#   - the commit metadata against the same word list, and that the history is exactly that one commit
# Any hit deletes the export and exits 1. Refuses an <outdir> that exists and is not empty, and refuses to run
# without a word list (.privacy-words here, or PUBLISH_WORDS=<file>): owner names must always be checked.
# It never adds a remote and never pushes.
#   PUBLISH_WORDS=<file>   word list to check against (read in place)
set -eu
set -o pipefail

src="$0"
while [ -L "$src" ]; do
  d="$(cd "$(dirname "$src")" && pwd -P)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
REPO="$(cd "$(dirname "$src")/.." && pwd -P)"

die() { printf 'publish-export: %s\n' "$*" >&2; exit 1; }

[ $# -eq 1 ] || { echo "usage: bin/publish-export <outdir>" >&2; exit 2; }
OUT="$1"
case "$OUT" in /*) ;; *) OUT="$(pwd -P)/$OUT" ;; esac
OUT="${OUT%/}"
[ -n "$OUT" ] || die "refusing to export into /"

NAME="${PUBLISH_NAME:-re-studio}"
EMAIL="${PUBLISH_EMAIL:-re-studio@users.noreply.github.com}"
WORDS="${PUBLISH_WORDS:-$REPO/.privacy-words}"
[ -f "$WORDS" ] || die "no word list at $WORDS: create .privacy-words (untracked) or set PUBLISH_WORDS"
git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$REPO is not a git work tree"

# The export directory: refuse when it is non-empty; remember whether we made it, for cleanup.
created=0
if [ -e "$OUT" ]; then
  [ -d "$OUT" ] || die "$OUT exists and is not a directory"
  if [ -n "$(ls -A "$OUT")" ]; then die "refusing: $OUT exists and is not empty"; fi
else
  mkdir -p "$OUT"
  created=1
fi

ok=0
cleanup() {
  [ "$ok" -eq 1 ] && return 0
  if [ "$created" -eq 1 ]; then
    rm -rf "$OUT"
  else
    for entry in "$OUT"/.[!.]* "$OUT"/*; do rm -rf "$entry"; done
  fi
  echo "publish-export: nothing kept: $OUT was cleared" >&2
}
trap cleanup EXIT

tmp="$(mktemp -d)"
trap 'cleanup; rm -rf "$tmp"' EXIT

# 1. Copy the tracked files (the index list, so untracked and ignored files stay out).
git -C "$REPO" ls-files -z > "$tmp/list"
count=0
while IFS= read -r -d '' f; do
  [ -d "$REPO/$f" ] && [ ! -L "$REPO/$f" ] && die "$f is a directory (a submodule?): not supported"
  [ -e "$REPO/$f" ] || [ -L "$REPO/$f" ] || die "tracked file is missing from the work tree: $f (restore it first)"
  mkdir -p "$OUT/$(dirname "$f")"
  cp -Pp "$REPO/$f" "$OUT/$f"
  count=$((count + 1))
done < "$tmp/list"
[ "$count" -gt 0 ] || die "no tracked files to export"

# 2. A fresh repo with those files staged.
git -C "$OUT" init -q
git -C "$OUT" symbolic-ref HEAD refs/heads/main
git -C "$OUT" add -A

# 3. Tree scan: the export's own test/privacy.sh over the staged files, before anything is committed.
[ -f "$OUT/test/privacy.sh" ] || die "test/privacy.sh is missing from the export: it cannot be checked"
if ! (cd "$OUT" && PRIVACY_WORDS="$WORDS" bash test/privacy.sh); then
  die "privacy tree scan found hits: nothing kept"
fi

# 4. The single commit, with an explicit identity (never the machine's own git config).
# The identity goes to this one command only: exporting it would leak into the nested checks.
GIT_AUTHOR_NAME="$NAME" GIT_AUTHOR_EMAIL="$EMAIL" GIT_COMMITTER_NAME="$NAME" GIT_COMMITTER_EMAIL="$EMAIL" \
  git -C "$OUT" -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -q -m "Initial public release"

# 5. History: exactly one commit, the generic identity on it, and the history scan of that commit
#    (test/privacy.sh --history: author, committer, message, paths and every blob it adds).
commits="$(git -C "$OUT" rev-list --all --count)"
[ "$commits" = 1 ] || die "history has $commits commits, expected 1: nothing kept"
author="$(git -C "$OUT" log -1 --format='%an <%ae>')"
committer="$(git -C "$OUT" log -1 --format='%cn <%ce>')"
[ "$author" = "$NAME <$EMAIL>" ] || die "author is '$author', expected '$NAME <$EMAIL>': nothing kept"
[ "$committer" = "$NAME <$EMAIL>" ] || die "committer is '$committer', expected '$NAME <$EMAIL>': nothing kept"
if ! (cd "$OUT" && PRIVACY_WORDS="$WORDS" bash test/privacy.sh --history); then
  die "privacy history scan found hits: nothing kept"
fi

ok=1
echo "exported: $OUT"
echo "  $count tracked file(s), 1 commit 'Initial public release', author $NAME <$EMAIL>"
echo "  not pushed. To publish it, add a remote and push yourself:"
echo "    git -C $OUT remote add origin <url>"
