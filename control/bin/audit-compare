#!/usr/bin/env python3
"""Ask the local model and Haiku about every studio team with today's prompt and print both verdicts side by side."""
import importlib.machinery, importlib.util, os, sys

if len(sys.argv) > 1 and sys.argv[1] in ("--help", "-h"):
    print("Ask the local model and Haiku for every studio team with the auditor's prompt and print both verdicts.")
    sys.exit(0)

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))
import audit_compare, audit_facts


def load_audit():
    loader = importlib.machinery.SourceFileLoader("re_audit", os.path.join(HERE, "re-audit"))
    spec = importlib.util.spec_from_loader("re_audit", loader)
    mod = importlib.util.module_from_spec(spec)
    argv, sys.argv = sys.argv, ["re-audit"]
    try:
        loader.exec_module(mod)
    finally:
        sys.argv = argv
    return mod


def main():
    ra = load_audit()
    units = ra.studio_units(ra._load_snap().everyone())
    units = [u for u in units if u[2].get("online")]
    rows = audit_compare.compare(units, audit_facts.plan, ra.STUDIO_STATUS[:-1], ra.STUDIO_KEYS, ra.local_text, ra.claude_json,
                                  fix=audit_facts.fix_reply)
    print(audit_compare.render(rows))


if __name__ == "__main__":
    main()
